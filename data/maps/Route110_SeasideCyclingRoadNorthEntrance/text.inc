

@ BEGIN PATCH (tools/hoenn_import/patches)
Route110_SeasideCyclingRoadNorthEntrance_Text_Offer::
    .string "This is the top of the CYCLING\n"
    .string "ROAD. Bicycles only past the gate.\p"
    .string "We time runs, if you want one.\n"
    .string "Top to bottom, no stopping.\p"
    .string "Shall I start the clock?$"

Route110_SeasideCyclingRoadNorthEntrance_Text_Go::
    .string "Clock's running. Go!\p"
    .string "My colleague at the south gate\n"
    .string "will stop it.$"

Route110_SeasideCyclingRoadNorthEntrance_Text_StillRunning::
    .string "You're timed already. The clock\n"
    .string "doesn't care that you came back\l"
    .string "up here.$"

Route110_SeasideCyclingRoadNorthEntrance_Text_Declined::
    .string "Fair enough. The road's the same\n"
    .string "either way.$"

Route110_SeasideCyclingRoadNorthEntrance_Text_H0::
    .string "The deck below is one long slope.\p"
    .string "People come from MAUVILLE just to\n"
    .string "coast down it.$"
@ END PATCH
