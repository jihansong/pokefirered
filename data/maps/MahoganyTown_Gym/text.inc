MahoganyTown_Gym_Text_Before::
    .string "PRYCE: Stop the lake's distress.\n"
    .string "Then I will test your resolve.$"

MahoganyTown_Gym_Text_Intro::
    .string "PRYCE: Life's winter taught me\n"
    .string "patience. Show me your strength!$"

MahoganyTown_Gym_Text_Defeat::
    .string "You have endured my winter.\n"
    .string "Your trust in POKEMON is strong.$"

MahoganyTown_Gym_Text_After::
    .string "PRYCE: Take the GLACIERBADGE\n"
    .string "and the rare TM for ICE BEAM.\p"
    .string "TEAM ROCKET may regroup at the\n"
    .string "RADIO TOWER. Warn GOLDENROD.$"

MahoganyTown_Gym_Text_Full::
    .string "The GLACIERBADGE is yours.\n"
    .string "Make room for ICE BEAM.\p"
    .string "Your victory is remembered.\n"
    .string "Come back for the TM later.$"

