

@ BEGIN PATCH (tools/hoenn_import/patches)
Route104_MrBrineysHouse_Text_Briney::
    .string "BRINEY: Ahoy! You're the one who\n"
    .string "fetched my PEEKO out of that\l"
    .string "tunnel!\p"
    .string "I'm an old sea dog, and I don't\n"
    .string "forget a kindness.\p"
    .string "My boat's at the dock just south.\n"
    .string "She's yours whenever you like.$"

Route104_MrBrineysHouse_Text_BrineyMudkipHint::
    .string "And PEEKO keeps circling the inlet\n"
    .string "under my pier. Something's down in\l"
    .string "that water, I'd wager.$"

Route104_MrBrineysHouse_Text_BrineyMudkipGot::
    .string "A MUDKIP! So that's what PEEKO was\n"
    .string "fussing over all week.$"

Route104_MrBrineysHouse_Text_Peeko::
    .string "PEEKO: Pihyoo! Pihyoo!$"
@ END PATCH
