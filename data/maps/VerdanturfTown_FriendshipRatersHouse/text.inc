

@ BEGIN PATCH (tools/hoenn_import/patches)
VerdanturfTown_FriendshipRatersHouse_Text_H0::
    .string "I don't rate for strangers.\p"
    .string "People WANDA sends, yes. Anyone\n"
    .string "walking in off the highland, no.$"

VerdanturfTown_FriendshipRatersHouse_Text_Rate::
    .string "Let me look at the one walking in\n"
    .string "front.\p"
    .string "Hold still…$"

VerdanturfTown_FriendshipRatersHouse_Text_R0::
    .string "It doesn't know you.\p"
    .string "That isn't an insult. It simply\n"
    .string "doesn't, yet.$"

VerdanturfTown_FriendshipRatersHouse_Text_R1::
    .string "It tolerates you.\p"
    .string "Walk it about a bit. That is most\n"
    .string "of the trick.$"

VerdanturfTown_FriendshipRatersHouse_Text_R2::
    .string "It has started watching where you\n"
    .string "go.\p"
    .string "That's the beginning of it.$"

VerdanturfTown_FriendshipRatersHouse_Text_R3::
    .string "It likes you well enough.\p"
    .string "It would rather be out with you\n"
    .string "than in the box.$"

VerdanturfTown_FriendshipRatersHouse_Text_R4::
    .string "It's fond of you.\p"
    .string "It leaned towards you when I said\n"
    .string "your name.$"

VerdanturfTown_FriendshipRatersHouse_Text_R5::
    .string "It's very fond of you.\p"
    .string "I'd say it would follow you out of\n"
    .string "the region.$"

VerdanturfTown_FriendshipRatersHouse_Text_R6::
    .string "Oh my.\p"
    .string "I have never seen one look at a\n"
    .string "person like that.\p"
    .string "Whatever you are doing, keep\n"
    .string "doing it.$"

VerdanturfTown_FriendshipRatersHouse_Text_NoMon::
    .string "You have nothing with you but an\n"
    .string "egg.\p"
    .string "Come back when it isn't an egg.$"

VerdanturfTown_FriendshipRatersHouse_Text_H1::
    .string "PIKACHU: Pika pika!$"
@ END PATCH
