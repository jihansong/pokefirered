@ The south gate stops the clock, pays out by time and keeps the record board.
Route110_SeasideCyclingRoadSouthEntrance_EventScript_Attendant::
	lock
	faceplayer
	goto_if_eq VAR_HOENN_CYCLING_STATE, 1, Route110_SeasideCyclingRoadSouthEntrance_EventScript_Finish
	goto Route110_SeasideCyclingRoadSouthEntrance_EventScript_Board
	end

Route110_SeasideCyclingRoadSouthEntrance_EventScript_Finish::
	special CyclingRoad_FinishRun
	buffernumberstring STR_VAR_1, VAR_RESULT
	msgbox Route110_SeasideCyclingRoadSouthEntrance_Text_Stopped
	goto_if_le VAR_RESULT, 60, Route110_SeasideCyclingRoadSouthEntrance_EventScript_PrizeGold
	goto_if_le VAR_RESULT, 90, Route110_SeasideCyclingRoadSouthEntrance_EventScript_PrizeSilver
	goto Route110_SeasideCyclingRoadSouthEntrance_EventScript_PrizeBronze

Route110_SeasideCyclingRoadSouthEntrance_EventScript_PrizeGold::
	msgbox Route110_SeasideCyclingRoadSouthEntrance_Text_Gold
	goto_if_set FLAG_HOENN_CYCLING_PRIZE_1, Route110_SeasideCyclingRoadSouthEntrance_EventScript_Board
	checkitemspace ITEM_PROTEIN
	goto_if_eq VAR_RESULT, FALSE, Route110_SeasideCyclingRoadSouthEntrance_EventScript_NoRoom
	giveitem_msg Route110_SeasideCyclingRoadSouthEntrance_Text_ReceivedPrize, ITEM_PROTEIN
	setflag FLAG_HOENN_CYCLING_PRIZE_1
	goto Route110_SeasideCyclingRoadSouthEntrance_EventScript_Board

Route110_SeasideCyclingRoadSouthEntrance_EventScript_PrizeSilver::
	msgbox Route110_SeasideCyclingRoadSouthEntrance_Text_Silver
	goto_if_set FLAG_HOENN_CYCLING_PRIZE_2, Route110_SeasideCyclingRoadSouthEntrance_EventScript_Board
	checkitemspace ITEM_CARBOS
	goto_if_eq VAR_RESULT, FALSE, Route110_SeasideCyclingRoadSouthEntrance_EventScript_NoRoom
	giveitem_msg Route110_SeasideCyclingRoadSouthEntrance_Text_ReceivedPrize, ITEM_CARBOS
	setflag FLAG_HOENN_CYCLING_PRIZE_2
	goto Route110_SeasideCyclingRoadSouthEntrance_EventScript_Board

Route110_SeasideCyclingRoadSouthEntrance_EventScript_PrizeBronze::
	msgbox Route110_SeasideCyclingRoadSouthEntrance_Text_Bronze
	goto_if_set FLAG_HOENN_CYCLING_PRIZE_3, Route110_SeasideCyclingRoadSouthEntrance_EventScript_Board
	checkitemspace ITEM_FRESH_WATER
	goto_if_eq VAR_RESULT, FALSE, Route110_SeasideCyclingRoadSouthEntrance_EventScript_NoRoom
	giveitem_msg Route110_SeasideCyclingRoadSouthEntrance_Text_ReceivedPrize, ITEM_FRESH_WATER
	setflag FLAG_HOENN_CYCLING_PRIZE_3
	goto Route110_SeasideCyclingRoadSouthEntrance_EventScript_Board

Route110_SeasideCyclingRoadSouthEntrance_EventScript_NoRoom::
	msgbox Route110_SeasideCyclingRoadSouthEntrance_Text_NoRoom
	release
	end

Route110_SeasideCyclingRoadSouthEntrance_EventScript_Board::
	special CyclingRoad_GetRecord
	goto_if_eq VAR_RESULT, 0, Route110_SeasideCyclingRoadSouthEntrance_EventScript_NoRecord
	buffernumberstring STR_VAR_1, VAR_RESULT
	msgbox Route110_SeasideCyclingRoadSouthEntrance_Text_Record
	release
	end

Route110_SeasideCyclingRoadSouthEntrance_EventScript_NoRecord::
	msgbox Route110_SeasideCyclingRoadSouthEntrance_Text_NoRecord
	release
	end
