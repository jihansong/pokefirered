Route110_TrickHousePuzzle_Text_FoundAScroll::
    .string "{PLAYER} found a scroll pinned to\n"
    .string "the wall.$"

Route110_TrickHousePuzzle_Text_SecretCodeWrittenOnIt::
    .string "There is a word written on it in\n"
    .string "enormous letters.$"

Route110_TrickHousePuzzle_Text_MemorizedSecretCode::
    .string "{PLAYER} learned the secret word.\p"
    .string "Behind the scroll, a hole in the\n"
    .string "wall. Of course there is.$"

Route110_TrickHouseEntrance_Text_YoureBeingWatched::
    .string "Someone in this room is watching\n"
    .string "{PLAYER}.\p"
    .string "Not a POKéMON. Something with an\n"
    .string "opinion about it.$"

Route110_TrickHouseEntrance_Text_TheyCallMeTrickMaster::
    .string "Wahahahaha! Found me!\p"
    .string "They call me the TRICK MASTER,\n"
    .string "and this house is entirely my\l"
    .string "fault.\p"
    .string "A champion from KANTO, in my\n"
    .string "house. Today is a very good day.$"

Route110_TrickHouseEntrance_Text_ComeToChallengeTrickHouse::
    .string "You have come to challenge the\n"
    .string "TRICK HOUSE!\p"
    .string "Eight rooms. Eight scrolls. Each\n"
    .string "one hides the way out, and each\l"
    .string "one is worse than the last.\p"
    .string "Find me first, mind. I am always\n"
    .string "hiding, and I am always somewhere\l"
    .string "ridiculous.$"

Route110_TrickHouseEntrance_Text_ConcealedBehindTree::
    .string "Wahahahaha! Behind the tree!\p"
    .string "A tree. Indoors. Nobody asks.$"

Route110_TrickHouseEntrance_Text_ConcealedBehindWindow::
    .string "Wahahahaha! Behind the window!\p"
    .string "Do not ask which side.$"

Route110_TrickHouseEntrance_Text_ConealedBeyondWindow::
    .string "Wahahahaha! Past the window!\p"
    .string "I have been out there for an hour\n"
    .string "and it is cold.$"

Route110_TrickHouseEntrance_Text_ConcealedBeneathCushion::
    .string "Wahahahaha! Under the cushion!\p"
    .string "I regret the cushion.$"

Route110_TrickHouseEntrance_Text_ConcealedBeneathDesk::
    .string "Wahahahaha! Under the desk!\p"
    .string "The classics never fail.$"

Route110_TrickHouseEntrance_Text_ConcealedInCupboard::
    .string "Wahahahaha! In the cupboard!\p"
    .string "There is a broom in here with me.$"

Route110_TrickHouseEntrance_Text_ConcealedInDresser::
    .string "Wahahahaha! In the dresser!\p"
    .string "Mind the drawers on your way out.$"

Route110_TrickHouseEntrance_Text_ConcealedInPlanter::
    .string "Wahahahaha! In the planter!\p"
    .string "I have soil in places I will not\n"
    .string "name.$"

Route110_TrickHouseEntrance_Text_ItsAScroll::
    .string "A scroll hangs where the door\n"
    .string "should be.$"

Route110_TrickHouseEntrance_Text_GoInHoleBehindScroll::
    .string "Behind the scroll there is a hole\n"
    .string "just big enough.\p"
    .string "Go in?$"

Route110_TrickHouseEntrance_Text_DoorLockedWriteSecretCodeHere::
    .string "The door is locked, and there is a\n"
    .string "space for a word.\p"
    .string "{PLAYER} wrote the secret word.$"

Route110_TrickHouseEntrance_Text_NextTimeUseThisTrick::
    .string "Wahahahaha! Out already!\p"
    .string "Next time I shall use a better\n"
    .string "trick. I have a drawer of them.$"

Route110_TrickHouseEntrance_Text_InMidstOfDevisingNewChallenges::
    .string "The TRICK MASTER is busy devising\n"
    .string "something dreadful.\p"
    .string "Come back when the next room is\n"
    .string "ready.$"

Route110_TrickHouseEntrance_Text_YoureHereToAcceptReward::
    .string "You are here for the prize! Of\n"
    .string "course you are!$"

Route110_TrickHouseEntrance_Text_DidYouNotComeToClaimReward::
    .string "Did you not come to claim your\n"
    .string "prize?\p"
    .string "It is heavy and I am tired of\n"
    .string "carrying it about.$"

Route110_TrickHouseEntrance_Text_MechadollWhichTent::
    .string "For finishing every room, the\n"
    .string "prizes. Both of them, as promised.$"

Route110_TrickHouseEntrance_Text_MechadollOtherPrize::
    .string "For finishing every room, a prize.\p"
    .string "The MASTER has changed his mind.\n"
    .string "You may have both!\p"
    .string "Which one did you not take?$"

Route110_TrickHouseEntrance_Text_PCFullAgain::
    .string "Your BAG will not take it.\p"
    .string "Come back lighter.$"

Route110_TrickHouseEntrance_Text_LeavingOnJourneyNote::
    .string "A note, in enormous letters:\p"
    .string "“GONE TO THINK OF WORSE IDEAS.\n"
    .string "BACK WHEN I HAVE ONE.”$"

Route110_TrickHouseEntrance_Text_ThenFarewell::
    .string "Then farewell, champion!\p"
    .string "Wahahahaha!$"
