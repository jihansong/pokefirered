MahoganyTown_Text_ResidentBefore::
    .string "PRYCE watches the trouble at\n"
    .string "the LAKE OF RAGE closely.\p"
    .string "Look north before challenging\n"
    .string "him at the GYM.$"

MahoganyTown_Text_ResidentAfter::
    .string "The radio signal has stopped.\n"
    .string "PRYCE has returned to his GYM.$"

MahoganyTown_Text_EastBefore::
    .string "Investigate the lake and earn\n"
    .string "PRYCE's GLACIERBADGE first.$"

MahoganyTown_Text_RadioNews::
    .string "GOLDENROD's RADIO TOWER called.\n"
    .string "TEAM ROCKET has taken it over!\p"
    .string "That same group fled KANTO.\n"
    .string "Please warn GOLDENROD's staff.$"

MahoganyTown_Text_EastOpen::
    .string "The RADIO TOWER is safe again.\n"
    .string "The road to BLACKTHORN is open.$"

