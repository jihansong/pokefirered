

@ BEGIN PATCH (tools/hoenn_import/patches)
LittlerootTown_BrendansHouse_1F_Text_LandladyFirstMeet::
    .string "Oh! You'll be the TRAINER off the\n"
    .string "KANTO plane. Word came up from\l"
    .string "SLATEPORT days ago.\p"
    .string "I'm MRS. WREN. I keep a room for\n"
    .string "travellers, and it's been empty\l"
    .string "since spring.\p"
    .string "It's yours for as long as you're\n"
    .string "in HOENN. No charge. I like a full\l"
    .string "house.\p"
    .string "Your room's at the top of the\n"
    .string "stairs. The bed's made up.$"

LittlerootTown_BrendansHouse_1F_Text_LandladyRepeat::
    .string "Back again? Supper's at six,\n"
    .string "whether you're here or not.$"

LittlerootTown_BrendansHouse_1F_Text_LandladyBedHint::
    .string "You look worn out. Go on up and\n"
    .string "lie down, you and your POKéMON\l"
    .string "both.\p"
    .string "A night in a proper bed does more\n"
    .string "than any machine. Come and go as\l"
    .string "you please.$"

LittlerootTown_BrendansHouse_1F_Text_PippaFirstMeet::
    .string "Gran says you're a CHAMPION.\p"
    .string "I'm PIPPA. I'm going to be one too,\n"
    .string "once I'm allowed past the fence.$"

LittlerootTown_BrendansHouse_1F_Text_PippaRepeat::
    .string "I made your bed! Well, I sat on it.\n"
    .string "Gran says that counts as helping.$"
@ END PATCH
