Route119_TYRival_FreshText::
	.string "Here, take this HM. It teaches FLY.\p"
	.string "With WINONA's BADGE, you can return\n"
	.string "to the towns you've visited in HOENN.$"

Route119_TYRival_FreshThanks::
	.string "The same HM works across regions.\n"
	.string "Each region has its own BADGE rules.$"

Route119_TYRival_KnownText::
	.string "You already received FLY before.\p"
	.string "I won't give you another copy.\n"
	.string "Try this different technique instead!$"

Route119_TYRival_TechniqueText::
	.string "This TM teaches DRAGON CLAW.\n"
	.string "It's a reward for our rematch!$"

Route119_TYRival_FullText::
	.string "Your BAG has no room.\p"
	.string "Make some space, then talk to me.\n"
	.string "No need to battle again for the gift!$"
