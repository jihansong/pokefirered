Route110_TrickHousePuzzle1_Text_EddieIntro::
    .string "This room is all trees and no\n"
    .string "garden. That's the joke, I think.$"

Route110_TrickHousePuzzle1_Text_EddieDefeat::
    .string "Beaten among the shrubbery.$"

Route110_TrickHousePuzzle1_Text_EddiePostBattle::
    .string "Cut what you can and walk round\n"
    .string "what you can't.$"

Route110_TrickHousePuzzle1_Text_RobinIntro::
    .string "I came in for the prize and stayed\n"
    .string "for the company. There isn't any.$"

Route110_TrickHousePuzzle1_Text_RobinDefeat::
    .string "Now there's less of it.$"

Route110_TrickHousePuzzle1_Text_RobinPostBattle::
    .string "The scroll's always at the far\n"
    .string "end. He's not subtle, our host.$"

Route110_TrickHousePuzzle1_Text_SallyIntro::
    .string "Don't tell me you're doing all\n"
    .string "eight rooms.\p"
    .string "…You are, aren't you.$"

Route110_TrickHousePuzzle1_Text_SallyDefeat::
    .string "Of course you are.$"

Route110_TrickHousePuzzle1_Text_SallyPostBattle::
    .string "Eight rooms and he'll still say\n"
    .string "you were lucky.$"

Route110_TrickHousePuzzle1_Text_WroteSecretCodeLockOpened::
    .string "{PLAYER} wrote the secret word on\n"
    .string "the door.\p"
    .string "The lock turned itself over and\n"
    .string "the door swung wide.$"
