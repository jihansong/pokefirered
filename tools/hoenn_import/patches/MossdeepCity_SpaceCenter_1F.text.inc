@ Thunder Yellow weather-space v1
MossdeepCity_SpaceCenter_1F_Text_BeforeResearch::
	.string "Our satellites observe the\n"
	.string "ocean as well as the sky.\p"
	.string "STEVEN is upstairs, waiting for\n"
	.string "the WEATHER INSTITUTE report.$"

MossdeepCity_SpaceCenter_1F_Text_Prepare::
	.string "STEVEN is upstairs. He asks you\n"
	.string "to prepare at MOSSDEEP GYM first.\p"
	.string "The deep-sea signal is growing\n"
	.string "stronger by the hour.$"

MossdeepCity_SpaceCenter_1F_Text_Raid::
	.string "TEAM MAGMA has entered upstairs!\n"
	.string "They are after our rocket fuel.\p"
	.string "STEVEN needs your help!$"

MossdeepCity_SpaceCenter_1F_Text_AfterRaid::
	.string "The rocket fuel is safe.\n"
	.string "The launch can proceed.\p"
	.string "Our satellite readings will help\n"
	.string "STEVEN locate the deep-sea signal.$"

MossdeepCity_SpaceCenter_1F_Text_Safety::
	.string "Rocket fuel is strictly guarded.\n"
	.string "Only our staff may handle it.$"

MossdeepCity_SpaceCenter_1F_Text_SafetyRaid::
	.string "Please help STEVEN upstairs.\n"
	.string "Keep MAGMA away from the fuel!$"

MossdeepCity_SpaceCenter_1F_Text_SafetyAfter::
	.string "You stopped the fuel theft.\n"
	.string "We can all breathe again!$"
