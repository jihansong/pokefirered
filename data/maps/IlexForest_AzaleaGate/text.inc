IlexForest_AzaleaGate_Text_SilverIntro::
    .string "SILVER: The KANTO CHAMPION?\n"
    .string "I heard you stopped TEAM ROCKET.\p"
    .string "And now you spend your time\n"
    .string "helping strangers and SLOWPOKE?\p"
    .string "Show me the strength that made\n"
    .string "you a CHAMPION!$"

IlexForest_AzaleaGate_Text_SilverDefeat::
    .string "You fought for your POKEMON,\n"
    .string "not just for yourself...$"

IlexForest_AzaleaGate_Text_SilverAfter::
    .string "SILVER: Those ROCKETS scattered\n"
    .string "after their defeat in KANTO.\p"
    .string "Someone is still giving them\n"
    .string "orders. I am going to GOLDENROD.\p"
    .string "I will find their leader.\n"
    .string "Stay out of my way!$"

IlexForest_AzaleaGate_Text_SilverNotReady::
    .string "SILVER: Finish what you started\n"
    .string "in AZALEA. Then face me here.$"

IlexForest_AzaleaGate_Text_Stop::
    .string "SILVER is waiting for a battle.\n"
    .string "Speak to him before going on.$"

IlexForest_AzaleaGate_Text_Officer::
    .string "ILEX FOREST is beyond this gate.\n"
    .string "The north path reaches ROUTE 34.\p"
    .string "The forest workers use CUT to\n"
    .string "clear fallen branches.$"

