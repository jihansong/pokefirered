

@ BEGIN PATCH (tools/hoenn_import/patches)
@ Free first choice and atomic exchange use the shared root-owned helpers.

MauvilleCity_BikeShop_Text_H0::
	.string "RYDEL'S CYCLES!\p"
	.string "The MACH BIKE is built for speed.\n"
	.string "The ACRO BIKE is made for tricks.$"

MauvilleCity_BikeShop_Text_H1::
	.string "I'm learning about BIKES while I\n"
	.string "work here.\p"
	.string "There are two handbooks in the\n"
	.string "back. RYDEL can explain things,\l"
	.string "too.$"

MauvilleCity_BikeShop_Text_H2::
	.string "A handbook on riding the MACH\n"
	.string "BIKE.$"

MauvilleCity_BikeShop_Text_H3::
	.string "A handbook on riding the ACRO\n"
	.string "BIKE.$"

MauvilleCity_BikeShop_Text_Service::
	.string "RYDEL: What can I do for you?$"

MauvilleCity_BikeShop_Text_FirstOffer::
	.string "RYDEL: You came a long way! I'll\n"
	.string "give you a BIKE for free.\p"
	.string "Would you like to choose one?$"

MauvilleCity_BikeShop_Text_AskExchange::
	.string "RYDEL: Would you like to exchange\n"
	.string "your HOENN BIKE?$"

MauvilleCity_BikeShop_Text_ChooseBike::
	.string "Choose a MACH BIKE for speed, or\n"
	.string "an ACRO BIKE for technical rides.$"

MauvilleCity_BikeShop_Text_Received::
	.string "{PLAYER} received the {STR_VAR_1}!$"

MauvilleCity_BikeShop_Text_ComeBack::
	.string "RYDEL: If you get the urge to\n"
	.string "switch BIKES, just come see me!$"

MauvilleCity_BikeShop_Text_AlreadyOwned::
	.string "RYDEL: You already have that\n"
	.string "BIKE. Keep enjoying the ride!$"

MauvilleCity_BikeShop_Text_BothBikes::
	.string "RYDEL: You already have both\n"
	.string "models. Nothing needs exchanging!$"

MauvilleCity_BikeShop_Text_BringBike::
	.string "RYDEL: Bring your MACH BIKE or\n"
	.string "ACRO BIKE here, and I'll exchange\l"
	.string "it for the other model.$"

MauvilleCity_BikeShop_Text_NoRoom::
	.string "RYDEL: I couldn't complete the\n"
	.string "exchange. Your items are\l"
	.string "unchanged.\p"
	.string "Make room in the KEY ITEMS pocket\n"
	.string "and try again.$"

MauvilleCity_BikeShop_Text_ChooseGuide::
	.string "Which BIKE would you like to\n"
	.string "learn about?$"

MauvilleCity_BikeShop_Text_NoRecord::
    .string "Haven't run the gate yet, have you.\p"
    .string "Go and do it. The board's been\n"
    .string "blank all month and it's starting\l"
    .string "to look like my fault.$"

MauvilleCity_BikeShop_Text_Record::
    .string "The gate has you at {STR_VAR_1}\n"
    .string "seconds.\p"
    .string "That's the frame, not you. Don't\n"
    .string "let it go to your head.$"

MauvilleCity_BikeShop_Text_RecordGold::
    .string "{STR_VAR_1} seconds. Under the\n"
    .string "minute.\p"
    .string "I built that frame in a week with\n"
    .string "my hands and I'd like that written\l"
    .string "somewhere.\p"
    .string "Off you go. Don't stop pedalling\n"
    .string "on my account.$"

MauvilleCity_BikeShop_Text_MachHandbookWhichPage::
	.string "It's a handbook on the MACH BIKE.\p"
	.string "Which page do you want to read?$"

MauvilleCity_BikeShop_Text_HowToRideMachBike::
	.string "A BIKE moves in the direction that\n"
	.string "the + Control Pad is pressed.\p"
	.string "It will speed up once it gets\n"
	.string "rolling.\p"
	.string "To stop, release the + Control\n"
	.string "Pad. The BIKE will slow to a\l"
	.string "stop.\p"
	.string "Want to read a different page?$"

MauvilleCity_BikeShop_Text_HowToTurnMachBike::
	.string "A MACH BIKE is speedy, but it\n"
	.string "can't stop very quickly.\p"
	.string "It gets a little tricky to get\n"
	.string "around a corner.\p"
	.string "Release the + Control Pad a\n"
	.string "little before the corner and slow\l"
	.string "down.\p"
	.string "Want to read a different page?$"

MauvilleCity_BikeShop_Text_SandySlopes::
	.string "There are small sandy slopes\n"
	.string "throughout the HOENN region.\p"
	.string "The loose, crumbly sand makes it\n"
	.string "impossible to climb normally.\p"
	.string "But if you have a MACH BIKE, you\n"
	.string "can zip up a sandy slope.\p"
	.string "Want to read a different page?$"

MauvilleCity_BikeShop_Text_AcroHandbookWhichPage::
	.string "It's a handbook on the ACRO BIKE.\p"
	.string "Which page do you want to read?$"

MauvilleCity_BikeShop_Text_Wheelies::
	.string "Press the B Button while riding,\n"
	.string "and the front wheel lifts up.\p"
	.string "You can zip around with the front\n"
	.string "wheel up using the + Control Pad.\p"
	.string "This technique is called a\n"
	.string "wheelie.\p"
	.string "Want to read a different page?$"

MauvilleCity_BikeShop_Text_BunnyHops::
	.string "Keeping the B Button pressed, your\n"
	.string "BIKE can hop on the spot.\p"
	.string "This technique is called a bunny\n"
	.string "hop.\p"
	.string "You can ride while hopping, too.\p"
	.string "Want to read a different page?$"

MauvilleCity_BikeShop_Text_Jumps::
	.string "Press the B Button and the +\n"
	.string "Control Pad at the same time to\l"
	.string "jump.\p"
	.string "Press the + Control Pad to the\n"
	.string "side to jump sideways.\p"
	.string "Press it backwards to make the\n"
	.string "BIKE change directions while\l"
	.string "jumping.\p"
	.string "Want to read a different page?$"
@ END PATCH
