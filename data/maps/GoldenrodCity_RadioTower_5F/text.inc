GoldenrodCity_RadioTower_5F_Text_ArcherIntro::
    .string "ARCHER: Our KANTO leader will\n"
    .string "hear this call and return!\p"
    .string "You stopped us there and at\n"
    .string "the lake. I will stop you here!$"

GoldenrodCity_RadioTower_5F_Text_ArcherDefeat::
    .string "GIOVANNI... Why did you not\n"
    .string "answer us? Our plan is over.$"

GoldenrodCity_RadioTower_5F_Text_ArcherAfter::
    .string "The ROCKET call falls silent.\n"
    .string "JOHTO's normal news returns.\p"
    .string "The director awaits belowground.\n"
    .string "LANCE will check the east road.$"

GoldenrodCity_RadioTower_5F_Text_ArcherBefore::
    .string "The transmitter is protected.\n"
    .string "Rescue the director first.$"

