

@ BEGIN PATCH (tools/hoenn_import/patches)
@ Thunder Yellow weather-space v1
MossdeepCity_SpaceCenter_2F_Text_TabithaIntro::
	.string "TABITHA: This rocket fuel will\n"
	.string "feed MT. CHIMNEY.\p"
	.string "MAGMA will remake the land!$"

MossdeepCity_SpaceCenter_2F_Text_TabithaDefeat::
	.string "You broke through our defense!$"

MossdeepCity_SpaceCenter_2F_Text_TabithaAfter::
	.string "TABITHA: MAXIE will finish this!\n"
	.string "I will not fight you again.$"

MossdeepCity_SpaceCenter_2F_Text_MaxieWait::
	.string "MAXIE: TABITHA, keep this\n"
	.string "trainer away from the fuel!$"

MossdeepCity_SpaceCenter_2F_Text_MaxieIntro::
	.string "MAXIE: AQUA seeks the deep sea.\n"
	.string "We will answer with fire.\p"
	.string "This fuel will strengthen the\n"
	.string "land. You cannot stop us!$"

MossdeepCity_SpaceCenter_2F_Text_MaxieDefeat::
	.string "Even here, our plan has failed!$"

MossdeepCity_SpaceCenter_2F_Text_MaxieRetreat::
	.string "MAXIE: The fuel is yours.\n"
	.string "We must reconsider our plans.\p"
	.string "But do not ignore AQUA.\n"
	.string "Their search has not ended!$"

MossdeepCity_SpaceCenter_2F_Text_StevenSaved::
	.string "STEVEN: The SPACE CENTER is\n"
	.string "safe. Thank you!\p"
	.string "Speak with me before you go.\n"
	.string "The readings reveal our next lead.$"

MossdeepCity_SpaceCenter_2F_Text_StevenBefore::
	.string "STEVEN: I am studying a signal\n"
	.string "far beneath HOENN.\p"
	.string "The WEATHER INSTITUTE on\n"
	.string "ROUTE 119 has the missing data.\p"
	.string "Please check on its researchers.$"

MossdeepCity_SpaceCenter_2F_Text_SurveyConnection::
	.string "STEVEN: This matches the gap in\n"
	.string "the survey STERN sent us.\p"
	.string "Your journey from the harbor\n"
	.string "has brought us to its source.$"

MossdeepCity_SpaceCenter_2F_Text_StevenPrepare::
	.string "STEVEN: Thank you for helping\n"
	.string "the WEATHER INSTITUTE.\p"
	.string "Visit TATE and LIZA at the GYM.\n"
	.string "Their badge proves your readiness.\p"
	.string "Then return here. I will\n"
	.string "compare the satellite readings.$"

MossdeepCity_SpaceCenter_2F_Text_StevenRaid::
	.string "STEVEN: MAGMA wants the rocket\n"
	.string "fuel to awaken the volcano.\p"
	.string "Please defeat TABITHA, then\n"
	.string "MAXIE. I will guard the fuel.\p"
	.string "You can leave to heal your team.\n"
	.string "I will keep the staff safe.$"

MossdeepCity_SpaceCenter_2F_Text_RecoveredChapterLead::
 .string "STEVEN: The trail begins with\n"
 .string "the stolen orbs at MT. PYRE.\p"
 .string "Check MAGMA's base below the\n"
 .string "JAGGED PASS, then find STERN\l"
 .string "at SLATEPORT's harbor.\p"
 .string "AQUA's LILYCOVE hideout may\n"
 .string "reveal where the submarine went.$"

MossdeepCity_SpaceCenter_2F_Text_DiveOffer::
	.string "STEVEN: Take HM08, DIVE.\n"
	.string "It will help with the sea search.$"

MossdeepCity_SpaceCenter_2F_Text_DiveNoRoom::
	.string "STEVEN: Please make room in the\n"
	.string "TM CASE. I will keep HM08 for you.$"

MossdeepCity_SpaceCenter_2F_Text_StevenAfter::
	.string "STEVEN: Teach DIVE to a partner.\n"
	.string "Explore the dark water on ROUTE 128.\p"
	.string "Our lead is the SEAFLOOR CAVERN.\n"
	.string "AQUA is searching there.\p"
	.string "The disturbance may reach\n"
	.string "SOOTOPOLIS if it continues.$"

MossdeepCity_SpaceCenter_2F_Text_ScientistBefore::
	.string "We compare satellite readings\n"
	.string "with the WEATHER INSTITUTE.$"

MossdeepCity_SpaceCenter_2F_Text_ScientistRaid::
	.string "MAGMA is here for the fuel!\n"
	.string "STEVEN is protecting the staff.$"

MossdeepCity_SpaceCenter_2F_Text_ScientistAfter::
	.string "The fuel is safe. Our readings\n"
	.string "now confirm the deep-sea signal.$"

MossdeepCity_SpaceCenter_2F_Text_VisitorRaid::
	.string "I came to see a rocket launch,\n"
	.string "not a fight over its fuel!$"

MossdeepCity_SpaceCenter_2F_Text_VisitorSafe::
	.string "The stars are far away, but\n"
	.string "research also protects this world.$"

MossdeepCity_SpaceCenter_2F_Text_DiveAlternate::
 .string "STEVEN: You already have HM08.\n"
 .string "Another copy would not help.\p"
 .string "Take this rare TM instead.\n"
 .string "It contains SNATCH.$"

MossdeepCity_SpaceCenter_2F_Text_DiveAlternateUse::
 .string "STEVEN: SNATCH takes the foe's\n"
 .string "healing or support move.\p"
 .string "The thieves sought our supplies.\n"
 .string "Now you can turn the tables.$"

MossdeepCity_SpaceCenter_2F_Text_DiveAlternateNoRoom::
 .string "Make room for TM49 in your\n"
 .string "TM CASE, then speak to me again.\p"
 .string "I will keep your reward here.$"

MossdeepCity_SpaceCenter_2F_Text_DiveStored::
 .string "STEVEN: Your HM08 is in the\n"
 .string "PC item storage.\p"
 .string "Withdraw it to your TM CASE,\n"
 .string "then teach DIVE to a partner.\p"
 .string "Search the dark water on\n"
 .string "ROUTE 128 for AQUA's trail.$"
@ END PATCH
