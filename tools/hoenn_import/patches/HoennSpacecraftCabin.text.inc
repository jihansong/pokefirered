@ Shared mission text is in HoennSpaceportTerminal.

SpaceFacility_Text_LobbyDirections::
	.string "STEWARD: DECK A is navigation.\n"
	.string "The B-deck arena is through here.\p"
	.string "The clinic and PC are open.\n"
	.string "Return boarding is to the south.$"

SpaceFacility_Text_Shop::
	.string "Flight supplies, ready for sale.\n"
	.string "Please choose what you need.$"

SpaceFacility_Text_FoodShop::
	.string "Cold drinks for the journey.\n"
	.string "They restore HP when used.$"

SpaceFacility_Text_DrinkShop::
	.string "Welcome to the star lounge.\n"
	.string "Our drinks are alcohol-free.$"

SpaceFacility_Text_Rest::
	.string "Rest here with your POKEMON?\n"
	.string "We will restore HP, PP and status.$"

SpaceFacility_Text_Rested::
	.string "You and your team are rested.\n"
	.string "The stars are waiting for you.$"

SpaceFacility_Text_Decks::
	.string "A: FLIGHT AND CREW\n"
	.string "B: PASSENGERS AND SERVICES\p"
	.string "C: OBSERVATION AND EQUIPMENT\n"
	.string "The return berth is in the lobby.$"

SpaceFacility_Text_Navigation::
	.string "NAVIGATION: ORBIT cut our link.\n"
	.string "Their first agent is in the arena.\p"
	.string "Defeat IVO, then use engineering.\n"
	.string "The cargo crew needs your help.$"

SpaceFacility_Text_NavigationSafe::
	.string "NAVIGATION: The uplink is clear.\n"
	.string "Crew recovery is our priority.\p"
	.string "Visit cargo, then observation.\n"
	.string "The lobby remains your way home.$"

SpaceFacility_Text_NavigationDone::
	.string "NAVIGATION: All crew are safe.\n"
	.string "The research channel is restored.\p"
	.string "JIRACHI is free to choose.\n"
	.string "There is no capture requirement.$"

SpaceFacility_Text_Cockpit::
	.string "PILOT: This is the flight deck.\n"
	.string "Navigation handles radio traffic.\p"
	.string "Our controls hold a safe orbit.\n"
	.string "The tank stays behind after launch.$"

SpaceFacility_Text_CaptainOffice::
	.string "REED: ORBIT blocked our radio.\n"
	.string "Navigation is tracing the signal.\p"
	.string "Protect the crew, not just data.\n"
	.string "I will bring everyone home.$"

SpaceFacility_Text_CaptainOfficeSafe::
	.string "REED: Thank you for the rescue.\n"
	.string "Ground control handles the grant.\p"
	.string "Return through the lobby, then\n"
	.string "report at the SPACE CENTER.$"

SpaceFacility_Text_CrewQuarters::
	.string "CREW: Our lockers and bunks are\n"
	.string "reserved for off-duty rest.\p"
	.string "You may rest at the spare bunk.\n"
	.string "The flight crew stays on watch.$"

SpaceFacility_Text_CrewMess::
	.string "COOK: This mess serves the crew.\n"
	.string "The passenger food court is below.\p"
	.string "A meal and a rest are ready.\n"
	.string "Use the table when you need them.$"

SpaceFacility_Text_FoodGuest::
	.string "I saw a comet past the window.\n"
	.string "It glowed like a wish coming true.$"

SpaceFacility_Text_LoungeGuest::
	.string "That technician asked about the\n"
	.string "cargo lock, not the star charts.$"

SpaceFacility_Text_ArenaSpectator::
	.string "That technician keeps checking\n"
	.string "the cargo lock between matches.$"

SpaceFacility_Text_ArenaPeace::
	.string "With IVO gone, the arena is quiet.\n"
	.string "I can hear the passengers cheering.$"

SpaceFacility_Text_Corridor::
	.string "Passenger rooms are down the hall.\n"
	.string "The lobby has the clinic and PC.$"

SpaceFacility_Text_Guest1::
	.string "I brought a notebook of stars.\n"
	.string "Please keep the cargo crew safe.$"

SpaceFacility_Text_Guest2::
	.string "I promised my little sister\n"
	.string "I would find a wishing star.\p"
	.string "Do you think the fallen star\n"
	.string "heard all of our wishes?$"

SpaceFacility_Text_Guest3::
	.string "The observation windows are open.\n"
	.string "I hope the lost researchers return.$"

SpaceFacility_Text_GameWelcome::
	.string "Would you like to buy 50 COINS?\n"
	.string "The price is 1,000.$"

SpaceFacility_Text_GameCase::
	.string "A COIN CASE is required.\n"
	.string "Take this spare case first.$"

SpaceFacility_Text_GameCaseFull::
	.string "There is no room for the case.\n"
	.string "Please clear a Key Item slot.$"

SpaceFacility_Text_GameMoney::
	.string "You do not have enough money.\n"
	.string "Come back when you have 1,000.$"

SpaceFacility_Text_GameCoinsFull::
	.string "Your COIN CASE cannot hold 50.\n"
	.string "Spend some COINS before buying.$"

SpaceFacility_Text_GameBought::
	.string "50 COINS were added to your case.\n"
	.string "The game cabinet is ready.$"

SpaceFacility_Text_GamePlay::
	.string "Try your luck?\n"
	.string "The game uses COINS.$"

SpaceFacility_Text_GameNoCase::
	.string "Bring a COIN CASE to play.\n"
	.string "The attendant has a spare one.$"

SpaceFacility_Text_GameNoCoins::
	.string "You have no COINS to play.\n"
	.string "You can buy 50 from the attendant.$"

SpaceFacility_Text_CargoOffer::
	.string "RESEARCHER: The lock is disabled!\n"
	.string "Help us send the research evidence?$"

SpaceFacility_Text_CargoLocked::
	.string "ORBIT still controls engineering.\n"
	.string "Disable their uplink first.$"

SpaceFacility_Text_CargoRescued::
	.string "The cargo crew is free!\n"
	.string "The evidence reaches ground.\p"
	.string "A light stirs in observation.\n"
	.string "Visit the fallen star if you wish.$"

SpaceFacility_Text_CargoAlready::
	.string "Our crew is safe, thanks to you.\n"
	.string "The captain can bring us home.$"

SpaceFacility_Text_NeedCargo::
	.string "The cargo crew is still trapped.\n"
	.string "Help them beyond engineering.\p"
	.string "This console cannot release them.\n"
	.string "The cargo researcher has the key.$"

SpaceFacility_Text_CargoClue::
	.string "ORBIT CAPTURE ARRAY: OFFLINE\n"
	.string "No life-form may be held here.$"

SpaceFacility_Text_CargoClueActive::
	.string "ORBIT CAPTURE ARRAY: ACTIVE\n"
	.string "ENGINEERING UPLINK: LOCKED$"
