LittlerootTown_ProfessorBirchsLab_EventScript_NextGoal200::
	setvar VAR_0x8005, 200
LittlerootTown_ProfessorBirchsLab_EventScript_ShowNextGoal::
	buffernumberstring STR_VAR_2, VAR_0x8005
	msgbox LittlerootTown_ProfessorBirchsLab_Text_BirchNextGoal
	return

LittlerootTown_ProfessorBirchsLab_EventScript_BagFull::
	msgbox LittlerootTown_ProfessorBirchsLab_Text_BirchBagFull
	return

@ The rival, back from ROUTE 103; the all-starters line once TREECKO and
@ MUDKIP have joined too (their own flags, nothing new stored)
LittlerootTown_ProfessorBirchsLab_EventScript_Rival::
	lock
	faceplayer
	setvar VAR_0x8004, 0
	goto_if_unset FLAG_HOENN_GOT_TREECKO_IN_WOODS, LittlerootTown_ProfessorBirchsLab_EventScript_RivalTalk
	goto_if_unset FLAG_HOENN_GOT_MUDKIP_ON_BEACH, LittlerootTown_ProfessorBirchsLab_EventScript_RivalTalk
	setvar VAR_0x8004, 1
LittlerootTown_ProfessorBirchsLab_EventScript_RivalTalk::
	checkplayergender
	goto_if_eq VAR_RESULT, FEMALE, LittlerootTown_ProfessorBirchsLab_EventScript_BrendanTalk
	goto_if_eq VAR_0x8004, 1, LittlerootTown_ProfessorBirchsLab_EventScript_MayAllStarters
	msgbox LittlerootTown_ProfessorBirchsLab_Text_MayLab
	release
	end

LittlerootTown_ProfessorBirchsLab_EventScript_MayAllStarters::
	msgbox LittlerootTown_ProfessorBirchsLab_Text_MayLabAllStarters
	release
	end

LittlerootTown_ProfessorBirchsLab_EventScript_BrendanTalk::
	goto_if_eq VAR_0x8004, 1, LittlerootTown_ProfessorBirchsLab_EventScript_BrendanAllStarters
	msgbox LittlerootTown_ProfessorBirchsLab_Text_BrendanLab
	release
	end

LittlerootTown_ProfessorBirchsLab_EventScript_BrendanAllStarters::
	msgbox LittlerootTown_ProfessorBirchsLab_Text_BrendanLabAllStarters
	release
	end

LittlerootTown_ProfessorBirchsLab_EventScript_JohtoReferral::
	msgbox LittlerootTown_ProfessorBirchsLab_Text_JohtoReferral
	return
@ END PATCH
