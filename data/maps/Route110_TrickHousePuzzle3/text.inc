Route110_TrickHousePuzzle3_Text_H0_0::
	.string "I keep coming back to this same\n"
	.string "place!$"

Route110_TrickHousePuzzle3_Text_H0_1::
	.string "I'm already having trouble, and then\n"
	.string "you have to beat me? It's not fair!$"

Route110_TrickHousePuzzle3_Text_H0_2::
	.string "It's full of doors here! It's too\n"
	.string "small and dark in here! Help!$"

Route110_TrickHousePuzzle3_Text_H1_0::
	.string "I don't know what's going on here.\n"
	.string "I'm starting to feel sad…$"

Route110_TrickHousePuzzle3_Text_H1_1::
	.string "You… You're awful!$"

Route110_TrickHousePuzzle3_Text_H1_2::
	.string "I know I'm weak!\n"
	.string "And, I have no sense of direction!$"

Route110_TrickHousePuzzle3_Text_H2_0::
	.string "I don't get it. What would anyone\n"
	.string "want with a house this bizarre?$"

Route110_TrickHousePuzzle3_Text_H2_1::
	.string "I don't get it.\n"
	.string "How did I lose?$"

Route110_TrickHousePuzzle3_Text_H2_2::
	.string "I don't get it.\n"
	.string "How many traps are in this house?\p"
	.string "You may be the one to solve that.$"

@ BEGIN PATCH (tools/hoenn_import/patches)
Route110_TrickHousePuzzle3_Text_AlanIntro::
    .string "Doors that open when other doors\n"
    .string "shut. He's very pleased with it.$"

Route110_TrickHousePuzzle3_Text_AlanDefeat::
    .string "He'll be less pleased now.$"

Route110_TrickHousePuzzle3_Text_AlanPostBattle::
    .string "Blue opens what green closes.\n"
    .string "That's all there is to it.$"

Route110_TrickHousePuzzle3_Text_JustinIntro::
    .string "I've been through this room four\n"
    .string "times and I still take the long\l"
    .string "way round.$"

Route110_TrickHousePuzzle3_Text_JustinDefeat::
    .string "Five times now.$"

Route110_TrickHousePuzzle3_Text_JustinPostBattle::
    .string "Watch which colour you stepped on\n"
    .string "last. That's the whole trick.$"

Route110_TrickHousePuzzle3_Text_MarthaIntro::
    .string "Every door in here is a door\n"
    .string "somewhere else isn't.$"

Route110_TrickHousePuzzle3_Text_MarthaDefeat::
    .string "…That made sense this morning.$"

Route110_TrickHousePuzzle3_Text_MarthaPostBattle::
    .string "The way out is always the door you\n"
    .string "opened first.$"

