MossdeepCity_SpaceCenter_2F_MapScripts::
@ Thunder Yellow weather-space v1
	map_script MAP_SCRIPT_ON_TRANSITION, MossdeepCity_SpaceCenter_2F_WeatherSpaceOnTransition
	map_script MAP_SCRIPT_ON_RESUME, MossdeepCity_SpaceCenter_2F_WeatherSpaceOnResume
	.byte 0

@ BEGIN PATCH (tools/hoenn_import/patches)
@ Thunder Yellow weather-space v1

MossdeepCity_SpaceCenter_2F_WeatherSpaceOnTransition::
 call MossdeepCity_SpaceCenter_2F_EventScript_SetRaidState
 end
MossdeepCity_SpaceCenter_2F_WeatherSpaceOnResume::
 call MossdeepCity_SpaceCenter_2F_EventScript_SetRaidState
 goto_if_set FLAG_HIDE_HOENN_SPACE_RAID, MossdeepCity_SpaceCenter_2F_EventScript_RemoveRaid
 addobject 5
 addobject 6
 end
MossdeepCity_SpaceCenter_2F_EventScript_RemoveRaid::
 removeobject 5
 removeobject 6
 end
MossdeepCity_SpaceCenter_2F_EventScript_SetRaidState::
 setflag FLAG_HIDE_HOENN_SPACE_RAID
 goto_if_set FLAG_HOENN_SPACE_CENTER_SECURED, MossdeepCity_SpaceCenter_2F_EventScript_StateReturn
 goto_if_unset FLAG_HOENN_WEATHER_RESCUED, MossdeepCity_SpaceCenter_2F_EventScript_StateReturn
 goto_if_unset FLAG_HOENN_BADGE07_GET, MossdeepCity_SpaceCenter_2F_EventScript_StateReturn
 goto_if_defeated TRAINER_HOENN_MAXIE_SPACE_CENTER, MossdeepCity_SpaceCenter_2F_EventScript_CheckTabithaForClear
 clearflag FLAG_HIDE_HOENN_SPACE_RAID
 return
MossdeepCity_SpaceCenter_2F_EventScript_CheckTabithaForClear::
 goto_if_defeated TRAINER_HOENN_TABITHA_SPACE_CENTER, MossdeepCity_SpaceCenter_2F_EventScript_ClearBackfill
 clearflag FLAG_HIDE_HOENN_SPACE_RAID
 return
MossdeepCity_SpaceCenter_2F_EventScript_ClearBackfill::
 setflag FLAG_HOENN_SPACE_CENTER_SECURED
MossdeepCity_SpaceCenter_2F_EventScript_StateReturn::
 return
MossdeepCity_SpaceCenter_2F_EventScript_Tabitha::
 lock
 faceplayer
 goto_if_set FLAG_HOENN_SPACE_CENTER_SECURED, EventScript_ReleaseEnd
 goto_if_unset FLAG_HOENN_WEATHER_RESCUED, EventScript_ReleaseEnd
 goto_if_unset FLAG_HOENN_BADGE07_GET, EventScript_ReleaseEnd
 goto_if_defeated TRAINER_HOENN_TABITHA_SPACE_CENTER, MossdeepCity_SpaceCenter_2F_EventScript_TabithaAfter
 trainerbattle_single TRAINER_HOENN_TABITHA_SPACE_CENTER, MossdeepCity_SpaceCenter_2F_Text_TabithaIntro, MossdeepCity_SpaceCenter_2F_Text_TabithaDefeat, MossdeepCity_SpaceCenter_2F_EventScript_TabithaAfter
 goto MossdeepCity_SpaceCenter_2F_EventScript_TabithaAfter
MossdeepCity_SpaceCenter_2F_EventScript_TabithaAfter::
 msgbox MossdeepCity_SpaceCenter_2F_Text_TabithaAfter
 release
 end
MossdeepCity_SpaceCenter_2F_EventScript_Maxie::
 lock
 faceplayer
 goto_if_set FLAG_HOENN_SPACE_CENTER_SECURED, EventScript_ReleaseEnd
 goto_if_unset FLAG_HOENN_WEATHER_RESCUED, EventScript_ReleaseEnd
 goto_if_unset FLAG_HOENN_BADGE07_GET, EventScript_ReleaseEnd
 goto_if_defeated TRAINER_HOENN_TABITHA_SPACE_CENTER, MossdeepCity_SpaceCenter_2F_EventScript_MaxieReady
 msgbox MossdeepCity_SpaceCenter_2F_Text_MaxieWait
 release
 end
MossdeepCity_SpaceCenter_2F_EventScript_MaxieReady::
 trainerbattle_single TRAINER_HOENN_MAXIE_SPACE_CENTER, MossdeepCity_SpaceCenter_2F_Text_MaxieIntro, MossdeepCity_SpaceCenter_2F_Text_MaxieDefeat, MossdeepCity_SpaceCenter_2F_EventScript_MaxieAfter
 goto MossdeepCity_SpaceCenter_2F_EventScript_MaxieAfter
MossdeepCity_SpaceCenter_2F_EventScript_MaxieAfter::
 setflag FLAG_HOENN_SPACE_CENTER_SECURED
 setflag FLAG_HIDE_HOENN_SPACE_RAID
 msgbox MossdeepCity_SpaceCenter_2F_Text_MaxieRetreat
 closemessage
 fadescreen FADE_TO_BLACK
 removeobject 5
 removeobject 6
 fadescreen FADE_FROM_BLACK
 msgbox MossdeepCity_SpaceCenter_2F_Text_StevenSaved
 release
 end
MossdeepCity_SpaceCenter_2F_EventScript_Steven::
 lock
 faceplayer
 goto_if_set FLAG_HOENN_SPACE_CENTER_SECURED, MossdeepCity_SpaceCenter_2F_EventScript_StevenAfter
 goto_if_unset FLAG_HOENN_WEATHER_RESCUED, MossdeepCity_SpaceCenter_2F_EventScript_StevenBefore
 goto_if_unset FLAG_HOENN_SURVEY_LETTER_DONE, MossdeepCity_SpaceCenter_2F_EventScript_StevenNoSurvey
 msgbox MossdeepCity_SpaceCenter_2F_Text_SurveyConnection
MossdeepCity_SpaceCenter_2F_EventScript_StevenNoSurvey::
 goto_if_unset FLAG_HOENN_BADGE07_GET, MossdeepCity_SpaceCenter_2F_EventScript_StevenPrepare
 msgbox MossdeepCity_SpaceCenter_2F_Text_StevenRaid
 release
 end
MossdeepCity_SpaceCenter_2F_EventScript_StevenBefore::
 msgbox MossdeepCity_SpaceCenter_2F_Text_StevenBefore
 release
 end
MossdeepCity_SpaceCenter_2F_EventScript_StevenPrepare::
 msgbox MossdeepCity_SpaceCenter_2F_Text_StevenPrepare
 release
 end
MossdeepCity_SpaceCenter_2F_EventScript_StevenAfter::
 goto_if_set FLAG_HOENN_GOT_HM08_FROM_STEVEN, MossdeepCity_SpaceCenter_2F_EventScript_DiveReport
 checkitem ITEM_HM08
 goto_if_eq VAR_RESULT, TRUE, MossdeepCity_SpaceCenter_2F_EventScript_DiveReceived
 msgbox MossdeepCity_SpaceCenter_2F_Text_DiveOffer
 giveitem ITEM_HM08
 goto_if_eq VAR_RESULT, FALSE, MossdeepCity_SpaceCenter_2F_EventScript_DiveNoRoom
MossdeepCity_SpaceCenter_2F_EventScript_DiveReceived::
 setflag FLAG_HOENN_GOT_HM08_FROM_STEVEN
MossdeepCity_SpaceCenter_2F_EventScript_DiveReport::
 msgbox MossdeepCity_SpaceCenter_2F_Text_StevenAfter
 release
 end
MossdeepCity_SpaceCenter_2F_EventScript_DiveNoRoom::
 msgbox MossdeepCity_SpaceCenter_2F_Text_DiveNoRoom
 release
 end
MossdeepCity_SpaceCenter_2F_EventScript_Scientist::
 lock
 faceplayer
 goto_if_set FLAG_HOENN_SPACE_CENTER_SECURED, MossdeepCity_SpaceCenter_2F_EventScript_ScientistAfter
 goto_if_set FLAG_HIDE_HOENN_SPACE_RAID, MossdeepCity_SpaceCenter_2F_EventScript_ScientistBefore
 msgbox MossdeepCity_SpaceCenter_2F_Text_ScientistRaid
 release
 end
MossdeepCity_SpaceCenter_2F_EventScript_ScientistBefore::
 msgbox MossdeepCity_SpaceCenter_2F_Text_ScientistBefore
 release
 end
MossdeepCity_SpaceCenter_2F_EventScript_ScientistAfter::
 msgbox MossdeepCity_SpaceCenter_2F_Text_ScientistAfter
 release
 end
MossdeepCity_SpaceCenter_2F_EventScript_Visitor::
 lock
 faceplayer
 goto_if_set FLAG_HIDE_HOENN_SPACE_RAID, MossdeepCity_SpaceCenter_2F_EventScript_VisitorSafe
