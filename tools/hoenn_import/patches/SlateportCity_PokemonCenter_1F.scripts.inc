SlateportCity_PokemonCenter_1F_EventScript_NextRumor::
	addvar VAR_HOENN_RUMOR_STATE, 1
	goto_if_lt VAR_HOENN_RUMOR_STATE, 10, EventScript_ReleaseEnd
	setvar VAR_HOENN_RUMOR_STATE, 0
	release
	end
