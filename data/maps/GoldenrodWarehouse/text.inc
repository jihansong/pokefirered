GoldenrodWarehouse_Text_WAREHOUSE_GRUNT_AIntro::
    .string "No one leaves this warehouse!$"

GoldenrodWarehouse_Text_WAREHOUSE_GRUNT_ADefeat::
    .string "You found our hiding place!$"

GoldenrodWarehouse_Text_WAREHOUSE_GRUNT_AAfter::
    .string "The director knows the code\n"
    .string "for our sealed studio doors.$"

GoldenrodWarehouse_Text_WAREHOUSE_GRUNT_BIntro::
    .string "The director stays right here!$"

GoldenrodWarehouse_Text_WAREHOUSE_GRUNT_BDefeat::
    .string "The guards could not stop you!$"

GoldenrodWarehouse_Text_WAREHOUSE_GRUNT_BAfter::
    .string "ARIANA guards the transmitter.\n"
    .string "ARCHER waits above her.$"

GoldenrodWarehouse_Text_WAREHOUSE_SCIENTISTIntro::
    .string "The station will call GIOVANNI!$"

GoldenrodWarehouse_Text_WAREHOUSE_SCIENTISTDefeat::
    .string "The link to KANTO is failing!$"

GoldenrodWarehouse_Text_WAREHOUSE_SCIENTISTAfter::
    .string "Without the director's code,\n"
    .string "the upper studios remain shut.$"

GoldenrodWarehouse_Text_DirectorBefore::
    .string "The guards hold the studio code.\n"
    .string "Please defeat all three guards.$"

GoldenrodWarehouse_Text_DirectorRescued::
    .string "You saved me! Use my studio code\n"
    .string "to reach the fourth floor.\p"
    .string "Their lake signal and this call\n"
    .string "are the same ROCKET operation.\p"
    .string "Stop their leaders. I will\n"
    .string "coordinate the repairs here.$"

GoldenrodWarehouse_Text_DirectorWaiting::
    .string "The upper studio door is open.\n"
    .string "ARIANA and ARCHER are upstairs.\p"
    .string "My staff are still trapped.\n"
    .string "Please stop their broadcast.$"

GoldenrodWarehouse_Text_DirectorAfter::
    .string "SUNNY DAY is my thanks to you.\n"
    .string "Our staff can broadcast again.\p"
    .string "LANCE linked the KANTO thefts\n"
    .string "to their JOHTO radio project.\p"
    .string "HOENN's coastal stations sent\n"
    .string "reports of unusual weather.\p"
    .string "Finish JOHTO's LEAGUE challenge.\n"
    .string "Then meet HOENN's coastal teams.$"

GoldenrodWarehouse_Text_DirectorHoennStorm::
    .string "SUNNY DAY is my thanks to you.\n"
    .string "Our staff can broadcast again.\p"
    .string "HOENN's sea legend has awakened.\n"
    .string "Coastal storms are still raging.\p"
    .string "LANCE will share our news with\n"
    .string "HOENN's coastal rescue teams.$"

GoldenrodWarehouse_Text_DirectorHoennCalm::
    .string "SUNNY DAY is my thanks to you.\n"
    .string "Our staff can broadcast again.\p"
    .string "HOENN thanked you for calming\n"
    .string "the storms with RAYQUAZA.\p"
    .string "The KANTO and JOHTO stations\n"
    .string "can exchange their news safely.$"

GoldenrodWarehouse_Text_DirectorFull::
    .string "The radio signal is already off.\n"
    .string "Your victory is remembered.\p"
    .string "Make room for SUNNY DAY.\n"
    .string "I will keep your TM safe.$"

