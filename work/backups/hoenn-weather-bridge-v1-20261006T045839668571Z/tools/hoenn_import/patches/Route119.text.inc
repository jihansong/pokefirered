

Route119_TYRival_MayIntro::
	.string "MAY: You saved the WEATHER INSTITUTE!\p"
	.string "Their sea-temperature report is odd.\n"
	.string "I'll take it back to BIRCH.\p"
	.string "You've traveled far since KANTO.\n"
	.string "Let's see what you've learned!$"

Route119_TYRival_MayBattleIntro::
	.string "MAY: My team has grown since\n"
	.string "we met on ROUTE 110. Here we go!$"

Route119_TYRival_MayDefeat::
	.string "MAY: Even my new team couldn't\n"
	.string "keep up! You're still improving!$"

Route119_TYRival_BrendanIntro::
