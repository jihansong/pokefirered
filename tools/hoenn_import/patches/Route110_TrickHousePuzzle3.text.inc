Route110_TrickHousePuzzle3_Text_AlanIntro::
    .string "Doors that open when other doors\n"
    .string "shut. He's very pleased with it.$"

Route110_TrickHousePuzzle3_Text_AlanDefeat::
    .string "He'll be less pleased now.$"

Route110_TrickHousePuzzle3_Text_AlanPostBattle::
    .string "Blue opens what green closes.\n"
    .string "That's all there is to it.$"

Route110_TrickHousePuzzle3_Text_JustinIntro::
    .string "I've been through this room four\n"
    .string "times and I still take the long\l"
    .string "way round.$"

Route110_TrickHousePuzzle3_Text_JustinDefeat::
    .string "Five times now.$"

Route110_TrickHousePuzzle3_Text_JustinPostBattle::
    .string "Watch which colour you stepped on\n"
    .string "last. That's the whole trick.$"

Route110_TrickHousePuzzle3_Text_MarthaIntro::
    .string "Every door in here is a door\n"
    .string "somewhere else isn't.$"

Route110_TrickHousePuzzle3_Text_MarthaDefeat::
    .string "…That made sense this morning.$"

Route110_TrickHousePuzzle3_Text_MarthaPostBattle::
    .string "The way out is always the door you\n"
    .string "opened first.$"

Route110_TrickHousePuzzle3_Text_WroteSecretCodeLockOpened::
    .string "{PLAYER} wrote the secret word on\n"
    .string "the door.\p"
    .string "The lock turned itself over and\n"
    .string "the door swung wide.$"
