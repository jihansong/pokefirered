

@ BEGIN PATCH (tools/hoenn_import/patches)
PetalburgCity_PokemonCenter_1F_Text_H0::
    .string "You can reach your KANTO BOXES\n"
    .string "from a HOENN PC now.\p"
    .string "Whoever wired that up deserves a\n"
    .string "statue in every town.$"

PetalburgCity_PokemonCenter_1F_Text_H1::
    .string "Something lives at the big tree in\n"
    .string "PETALBURG WOODS.\p"
    .string "Every time I go near, the grass\n"
    .string "shakes and something green glares\l"
    .string "at me. I don't go near any more.$"

PetalburgCity_PokemonCenter_1F_Text_H2::
    .string "A little blue POKéMON was lying in\n"
    .string "the shallows on ROUTE 104, under\l"
    .string "the old sailor's pier.\p"
    .string "Worn out, poor thing. I think it\n"
    .string "came a long way to get there.$"
@ END PATCH
