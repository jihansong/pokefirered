TournamentHall_Text_AnnouncerIntro::
    .string "Welcome to the CHAMPION TOURNAMENT!\p"
    .string "Eight names go into the draw, and\n"
    .string "you face three of them in a row.\p"
    .string "We heal your POKéMON between\n"
    .string "matches. Lose one, and you're out.\p"
    .string "Shall we begin?$"

TournamentHall_Text_DrawMade::
    .string "The draw is made!\n"
    .string "Here comes your first opponent!$"

TournamentHall_Text_MatchAnnounce::
    .string "MATCH {STR_VAR_1}!\p"
    .string "{PLAYER} versus\n"
    .string "{STR_VAR_2} {STR_VAR_3}!$"

TournamentHall_Text_WonMatch::
    .string "What a battle!\p"
    .string "Your POKéMON are healed. The next\n"
    .string "match is about to begin!$"

TournamentHall_Text_WonTournament::
    .string "Three matches, three wins!\p"
    .string "{PLAYER} is the CHAMPION of the\n"
    .string "CHAMPION TOURNAMENT!$"

TournamentHall_Text_FirstTrophy::
    .string "Your trophy will be delivered to\n"
    .string "your room in PALLET TOWN.\p"
    .string "And please take these, too!$"

TournamentHall_Text_ComeBack::
    .string "Come back when you're ready.\n"
    .string "The draw waits for no one!$"
