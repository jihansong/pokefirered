

@ BEGIN PATCH (tools/hoenn_import/patches)
LittlerootTown_MaysHouse_1F_Text_MomBeforeRescue::
    .string "My husband? Out since dawn.\p"
    .string "He'll turn up. He always does,\n"
    .string "usually with something chasing him.$"

LittlerootTown_MaysHouse_1F_Text_MomThanks::
    .string "You're the one who got my husband\n"
    .string "out of that mess! Thank you.\p"
    .string "And MRS. WREN next door has put\n"
    .string "you up? Good. She'll feed you\l"
    .string "better than we would.$"

LittlerootTown_MaysHouse_1F_Text_MomAfterRivalMay::
    .string "MAY hasn't stopped talking about\n"
    .string "your battle.\p"
    .string "She's at the LAB with her father\n"
    .string "now. Those two, honestly. Supper\l"
    .string "goes cold every night.$"

LittlerootTown_MaysHouse_1F_Text_MomAfterRivalBrendan::
    .string "BRENDAN came home in a mood. A good\n"
    .string "one, I think. Hard to tell with him.\p"
    .string "He's at the LAB with his father\n"
    .string "now. Those two, honestly. Supper\l"
    .string "goes cold every night.$"
@ END PATCH
