Route116_Text_BrineyPeekoMissing::
	.string "PEEKO! My poor little PEEKO!\p"
	.string "A fellow in blue snatched my\n"
	.string "WINGULL and ran into the tunnel!\p"
	.string "I am MR. BRINEY. I have sailed\n"
	.string "through storms with her, but this…\p"
	.string "Please bring my PEEKO back.$"

Route116_Text_RepeatBallBeforeRescue::
	.string "I work for DEVON. Our deliveries\n"
	.string "travel through RUSTURF TUNNEL.\p"
	.string "If you see trouble in the tunnel,\n"
	.string "please help our delivery team.$"

Route116_Text_RepeatBallThanks::
	.string "You recovered the DEVON GOODS!\n"
	.string "Our whole team is grateful.\p"
	.string "Here is a REPEAT BALL from me!$"

Route116_Text_RepeatBallDone::
	.string "A REPEAT BALL works well on a\n"
	.string "species you have caught before.\p"
	.string "Try it when you meet another\n"
	.string "POKéMON you want to raise!$"

Route116_Text_RepeatBallNoRoom::
	.string "You cannot carry this ball now.\n"
	.string "I will keep it here for you.$"

Route116_Text_H11::
	.string "RUSTURF TUNNEL. The narrow\n"
	.string "footpath is passable. Noisy\p"
	.string "digging was stopped to protect\n"
	.string "wild POKEMON.$"

Route116_Text_TunnelSignFinished::
	.string "RUSTURF TUNNEL. The quiet\n"
	.string "footpath is complete. RUSTBORO\p"
	.string "and VERDANTURF can meet without\n"
	.string "disturbing wild POKEMON.$"
