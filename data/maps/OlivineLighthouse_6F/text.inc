OlivineLighthouse_6F_Text_Request::
    .string "AMPHY is sick. I cannot leave\n"
    .string "while the lamp is unwell.\p"
    .string "Please ask the CIANWOOD pharmacy\n"
    .string "for a sealed dose of medicine.\p"
    .string "MORTY's BADGE permits SURF here.\n"
    .string "The west beach is the sea route.$"

OlivineLighthouse_6F_Text_Deliver::
    .string "You brought the sealed medicine!\n"
    .string "Thank you. I'll give it to\n"
    .string "AMPHY.$"

OlivineLighthouse_6F_Text_Healthy::
    .string "AMPHY: Pharos!\p"
    .string "The lighthouse lamp shines\n"
    .string "again.$"

OlivineLighthouse_6F_Text_Return::
    .string "The harbor is safe again.\n"
    .string "I'll return to OLIVINE GYM.\p"
    .string "First meet CHUCK across the sea.\n"
    .string "Then we can have our GYM battle.$"

OlivineLighthouse_6F_Text_After::
    .string "AMPHY is healthy again.\n"
    .string "I'll be waiting at OLIVINE GYM.$"

