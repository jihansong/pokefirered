RustboroCity_DevonCorp_3F_Text_BeforeRescue::
	.string "MR. STONE: We build tools that help\n"
	.string "people and POKéMON work together.\p"
	.string "But even our finest inventions\n"
	.string "still need someone to carry them.$"

RustboroCity_DevonCorp_3F_Text_MissingGoods::
	.string "MR. STONE: You found our parcel?\n"
	.string "Please bring the DEVON GOODS here.\p"
	.string "Our researcher near RUSTURF TUNNEL\n"
	.string "was looking for them.$"

RustboroCity_DevonCorp_3F_Text_DeliveryRequest::
	.string "MR. STONE: Our missing parcel!\n"
	.string "Thank you for bringing it back.\p"
	.string "Those are parts for the submarine\n"
	.string "CAPTAIN STERN is building.\p"
	.string "Could you take them to him?\n"
	.string "He's at SLATEPORT's harbor.\p"
	.string "MR. BRINEY's boat can carry you\n"
	.string "there from ROUTE 104.\p"
	.string "Come back after the delivery.\n"
	.string "I have something for your team.$"

RustboroCity_DevonCorp_3F_Text_DeliveryWaiting::
	.string "MR. STONE: CAPTAIN STERN is at\n"
	.string "SLATEPORT's harbor.\p"
	.string "Take the DEVON GOODS to him, then\n"
	.string "come back and tell me how it went.$"

RustboroCity_DevonCorp_3F_Text_DeliveryThanks::
	.string "MR. STONE: STERN has the parts?\n"
	.string "Wonderful! You saved us a journey.\p"
	.string "Here's something to help the\n"
	.string "younger members of your team.$"

RustboroCity_DevonCorp_3F_Text_ReceivedExpShare::
	.string "{PLAYER} received an EXP. SHARE!$"

RustboroCity_DevonCorp_3F_Text_ExpShareUse::
	.string "MR. STONE: A POKéMON holding it\n"
	.string "shares in the EXP. from battle.\p"
	.string "Every great team starts small.$"

RustboroCity_DevonCorp_3F_Text_NoRoom::
	.string "MR. STONE: Your BAG is full.\n"
	.string "I'll keep your EXP. SHARE here.\p"
	.string "Make room and speak to me again.$"

RustboroCity_DevonCorp_3F_Text_Done::
	.string "MR. STONE: How is your team doing?\n"
	.string "Give that EXP. SHARE a good home.$"
@ END PATCH
