GoldenrodCity_NorthGate_Text_Officer::
    .string "ROUTE 35 reaches NATIONAL PARK.\n"
    .string "The east path leads to ECRUTEAK.\p"
    .string "WHITNEY has a message for you.\n"
    .string "Collect your BADGE before going.$"

GoldenrodCity_NorthGate_Text_Stop::
    .string "Finish your visit with WHITNEY.\n"
    .string "The northern trail can wait.$"

GoldenrodCity_NorthGate_Text_FloristBefore::
    .string "A strange tree blocks ROUTE 36.\n"
    .string "WHITNEY knows the forest worker.$"

GoldenrodCity_NorthGate_Text_FloristLend::
    .string "WHITNEY sent you? Take our\n"
    .string "SQUIRTBOTTLE for that odd tree.\p"
    .string "It hates water. Please try a\n"
    .string "little sprinkle, then be ready!$"

GoldenrodCity_NorthGate_Text_FloristAfter::
    .string "Use the borrowed SQUIRTBOTTLE\n"
    .string "on the strange tree on ROUTE 36.$"

