

@ BEGIN PATCH (tools/hoenn_import/patches)
LittlerootTown_BrendansHouse_2F_Text_H0::
    .string "A guest book lies open on the desk.\p"
    .string "The last entry is from spring:\n"
    .string "“Lovely stay. Too many ZIGZAGOON.”\p"
    .string "Below it, in round handwriting:\n"
    .string "“KANTO CHAMPION!!” - PIPPA$"

LittlerootTown_BrendansHouse_2F_Text_H1::
    .string "An old TV with a GAME BOY ADVANCE\n"
    .string "hooked up to it.\p"
    .string "Someone has taped a note to it:\n"
    .string "FOR GUESTS. PLEASE SHARE. - PIPPA$"

LittlerootTown_BrendansHouse_2F_Text_BedPrompt::
    .string "The bed MRS. WREN made up for you.\n"
    .string "Take a rest?$"

LittlerootTown_BrendansHouse_2F_Text_BedRested::
    .string "{PLAYER} rested with the POKéMON.\p"
    .string "Everyone feels refreshed!$"

LittlerootTown_BrendansHouse_2F_Text_PC::
    .string "The family PC. A note on it says:\n"
    .string "GUESTS MAY USE. - GRAN\p"
    .string "A second note underneath:\n"
    .string "NOT MY GAMES FOLDER. - PIPPA$"

LittlerootTown_BrendansHouse_2F_Text_WallClock::
    .string "The clock ticks a little loudly.\p"
    .string "MRS. WREN keeps it five minutes\n"
    .string "fast, so nobody's late for supper.$"
@ END PATCH
