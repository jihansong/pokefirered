GoldenrodCity_RadioTower_3F_Text_RADIO_SCIENTISTIntro::
    .string "This signal reaches all JOHTO!$"

GoldenrodCity_RadioTower_3F_Text_RADIO_SCIENTISTDefeat::
    .string "My amplification failed!$"

GoldenrodCity_RadioTower_3F_Text_RADIO_SCIENTISTAfter::
    .string "The real director has codes\n"
    .string "for the upper-floor transmitter.$"

GoldenrodCity_RadioTower_3F_Text_PetrelIntro::
    .string "PETREL: The director? Me?\n"
    .string "You fell for it again!$"

GoldenrodCity_RadioTower_3F_Text_PetrelDefeat::
    .string "Fine! The director is locked\n"
    .string "in the underground warehouse.$"

GoldenrodCity_RadioTower_3F_Text_PetrelAfter::
    .string "The warehouse access code is\n"
    .string "written in PETREL's notes.\p"
    .string "Use the UNDERGROUND entrance\n"
    .string "on GOLDENROD's western side.\p"
    .string "Find the director. His code\n"
    .string "opens the upper studio doors.$"

GoldenrodCity_RadioTower_3F_Text_PetrelBefore::
    .string "The director is recording.\n"
    .string "Please come back another day.$"

GoldenrodCity_RadioTower_3F_Text_UpperGateClosed::
    .string "The upper studio is sealed.\n"
    .string "Rescue the real director first.$"

