

@ BEGIN PATCH (tools/hoenn_import/patches)
AbandonedShip_Corridors_B1F_Text_H0::
    .string "A ship! A real one, with water in\n"
    .string "it!$"

AbandonedShip_Corridors_B1F_Text_H1_0::
    .string "SAILORS take their POKéMON to sea\n"
    .string "with them. Even to a ship that\l"
    .string "isn't going anywhere.$"

AbandonedShip_Corridors_B1F_Text_H1_1::
    .string "Holed below the waterline.$"

AbandonedShip_Corridors_B1F_Text_H1_2::
    .string "Her bottom deck is under the sea\n"
    .string "proper.\p"
    .string "You'd need a POKéMON that can dive\n"
    .string "to get any further, and I don't\l"
    .string "know one that will.$"

AbandonedShip_Corridors_B1F_Text_H2::
    .string "{PLAYER} turned the STORAGE KEY.\p"
    .string "It stuck in the lock and stayed\n"
    .string "there, but the door swung open.$"
@ END PATCH
