

@ BEGIN PATCH (tools/hoenn_import/patches)
MeteorFalls_1F_1R_Mountain_TextStolen::
	.string "MAGMA: The sample is ours.\nThe summit device is ready!$"

MeteorFalls_1F_1R_Mountain_TextSpotted::
	.string "MAGMA: A visiting researcher?\nKeep out of our measurements!$"

MeteorFalls_1F_1R_Mountain_TextHalt::
	.string "ARCHIE: Stop! That machine could\nturn the whole mountain unstable!$"

MeteorFalls_1F_1R_Mountain_TextEscape::
