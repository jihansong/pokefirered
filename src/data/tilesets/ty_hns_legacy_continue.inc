static bool8 TYHns_LeagueGateReady(void)
{
    return FlagGet(FLAG_BADGE01_GET) && FlagGet(FLAG_BADGE02_GET)
        && FlagGet(FLAG_BADGE03_GET) && FlagGet(FLAG_BADGE04_GET)
        && FlagGet(FLAG_BADGE05_GET) && FlagGet(FLAG_BADGE06_GET)
        && FlagGet(FLAG_BADGE07_GET) && FlagGet(FLAG_BADGE08_GET)
        && FlagGet(FLAG_SYS_GAME_CLEAR) && FlagGet(FLAG_JOHTO_BADGE08_GET)
        && FlagGet(FLAG_JOHTO_RADIO_TOWER_CLEARED);
}

static void TYHns_ClearLegacyMapCache(void)
{
    CpuFill16(0, gSaveBlock2Ptr->mapView, sizeof(gSaveBlock2Ptr->mapView));
}

// Re-enter through the normal warp loader after moving a saved position.
// Its saved ObjectEvents still use the old geometry; position-only migration
// would put the player sprite and the camera on different metatiles.
static void TYHns_QueueMigratedContinueWarp(void)
{
    gSaveBlock1Ptr->continueGameWarp = gSaveBlock1Ptr->location;
    gSaveBlock1Ptr->continueGameWarp.warpId = -1;
    gSaveBlock1Ptr->continueGameWarp.x = gSaveBlock1Ptr->pos.x;
    gSaveBlock1Ptr->continueGameWarp.y = gSaveBlock1Ptr->pos.y;
    SetContinueGameWarpStatus();
}

static void TYHns_MigrateLegacyContinue(void)
{
    const u8 *xy = NULL;
    const struct MapLayout *newLayout = NULL;
    u16 oldLayoutId = 0;
    u16 newLayoutId = 0;
    s16 oldWidth = 0, oldHeight = 0;
    s16 anchorX = 0, anchorY = 0;
    s32 index;
    bool8 isLeagueRoute = FALSE;
    if (UseContinueGameWarp() == TRUE)
        return;
    // Geometry does not change in the city; refresh its old border cache only.
    if (gSaveBlock1Ptr->location.mapGroup == 76 && gSaveBlock1Ptr->location.mapNum == 6
     && gSaveBlock1Ptr->mapLayoutId == 760 && gMapHeader.mapLayoutId == 760)
    {
        TYHns_ClearLegacyMapCache();
        return;
    }
    if (gSaveBlock1Ptr->location.mapGroup != 76)
        return;
    switch (gSaveBlock1Ptr->location.mapNum)
    {
    case 0: // JohtoCherrygroveAirstrip; existing map/warp identities retained.
        oldLayoutId = 754;
        newLayoutId = 838;
        newLayout = &TYHnsJohtoCherrygroveAirstrip_Layout;
        oldWidth = 32;
        oldHeight = 24;
        anchorX = 22;
        anchorY = 12;
        break;
    case 1: // JohtoRoute29; existing map/warp identities retained.
        oldLayoutId = 755;
        newLayoutId = 839;
        newLayout = &TYHnsJohtoRoute29_Layout;
        oldWidth = 40;
        oldHeight = 24;
        anchorX = 61;
        anchorY = 17;
        xy = sTYHnsLegacyXY_JohtoRoute29;
        break;
    case 2: // NewBarkTown; existing map/warp identities retained.
        oldLayoutId = 756;
        newLayoutId = 840;
        newLayout = &TYHnsNewBarkTown_Layout;
        oldWidth = 36;
        oldHeight = 28;
        anchorX = 10;
        anchorY = 10;
        xy = sTYHnsLegacyXY_NewBarkTown;
        break;
    case 3: // Existing native Lab identity; original HnS two-room geometry.
        oldLayoutId = 757;
        newLayoutId = 843;
        newLayout = &TYHnsNewBarkElmsLab_Layout;
        oldWidth = 13;
        oldHeight = 14;
        anchorX = 6;
        anchorY = 11;
        xy = sTYHnsLegacyXY_NewBarkElmsLab;
        break;
    case 112: // JohtoRoute27; existing map/warp identities retained.
        oldLayoutId = 826;
        newLayoutId = 841;
        newLayout = &TYHnsJohtoRoute27_Layout;
        oldWidth = 44;
        oldHeight = 26;
        anchorX = 31;
        anchorY = 20;
        xy = sTYHnsLegacyXY_JohtoRoute27;
        isLeagueRoute = TRUE;
        break;
    default:
        return;
    }
    if (gMapHeader.mapLayoutId != newLayoutId)
        return; // Header/source binding mismatch is an integration failure.
    if (gSaveBlock1Ptr->mapLayoutId == newLayoutId)
    {
        // Empty/nonempty cache does not alter the version decision.
        // In-bounds new-format positions remain byte-for-byte unchanged.
        if (gSaveBlock1Ptr->pos.x < 0 || gSaveBlock1Ptr->pos.y < 0
         || gSaveBlock1Ptr->pos.x >= newLayout->width || gSaveBlock1Ptr->pos.y >= newLayout->height)
        {
            gSaveBlock1Ptr->pos.x = anchorX;
            gSaveBlock1Ptr->pos.y = anchorY;
            TYHns_ClearLegacyMapCache();
            TYHns_QueueMigratedContinueWarp();
        }
        return;
    }
    if (gSaveBlock1Ptr->mapLayoutId != oldLayoutId)
        return; // UNKNOWN is never silently classified as an old layout.
    if (isLeagueRoute && (gSaveBlock1Ptr->pos.x <= 1 || !TYHns_LeagueGateReady()))
    {
        // Keep a pre-gate save before the gate: return to the actual adjacent
        // town's shore on dry land. Never grant badges, Surf, flags or TEMP_0.
        gSaveBlock1Ptr->location.mapGroup = 76;
        gSaveBlock1Ptr->location.mapNum = 2;
        gSaveBlock1Ptr->location.warpId = -1;
        gSaveBlock1Ptr->location.x = 24;
        gSaveBlock1Ptr->location.y = 12;
        gSaveBlock1Ptr->pos.x = 24;
        gSaveBlock1Ptr->pos.y = 12;
        gMapHeader = *Overworld_GetMapHeaderByGroupAndId(76, 2);
        gSaveBlock1Ptr->mapLayoutId = 840;
        gMapHeader.mapLayout = &TYHnsNewBarkTown_Layout;
        TYHns_ClearLegacyMapCache();
        TYHns_QueueMigratedContinueWarp();
        return;
    }
    if (xy != NULL)
    {
        if (gSaveBlock1Ptr->pos.x >= 0 && gSaveBlock1Ptr->pos.x < oldWidth
         && gSaveBlock1Ptr->pos.y >= 0 && gSaveBlock1Ptr->pos.y < oldHeight)
        {
            index = (gSaveBlock1Ptr->pos.y * oldWidth + gSaveBlock1Ptr->pos.x) * 2;
            gSaveBlock1Ptr->pos.x = xy[index];
            gSaveBlock1Ptr->pos.y = xy[index + 1];
        }
        else
        {
            gSaveBlock1Ptr->pos.x = anchorX;
            gSaveBlock1Ptr->pos.y = anchorY;
        }
    }
    else if (gSaveBlock1Ptr->pos.x < 0 || gSaveBlock1Ptr->pos.y < 0
          || gSaveBlock1Ptr->pos.x >= newLayout->width || gSaveBlock1Ptr->pos.y >= newLayout->height)
    {
        gSaveBlock1Ptr->pos.x = anchorX;
        gSaveBlock1Ptr->pos.y = anchorY;
    }
    gSaveBlock1Ptr->mapLayoutId = newLayoutId;
    gMapHeader.mapLayout = newLayout;
    TYHns_ClearLegacyMapCache();
    TYHns_QueueMigratedContinueWarp();
}
