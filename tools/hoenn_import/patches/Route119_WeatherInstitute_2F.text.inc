@ Thunder Yellow weather-space v1
Route119_WeatherInstitute_2F_Text_ShellyIntro::
	.string "SHELLY: These readings reveal\n"
	.string "where the deep currents meet.\p"
	.string "TEAM AQUA needs them.\n"
	.string "You will not stand in our way!$"

Route119_WeatherInstitute_2F_Text_ShellyDefeat::
	.string "You have washed out our plan!$"

Route119_WeatherInstitute_2F_Text_ShellyRetreat::
	.string "SHELLY: Keep your readings.\n"
	.string "We already know where to search.\p"
	.string "The ocean has a secret you have\n"
	.string "not even begun to understand!$"

Route119_WeatherInstitute_2F_Text_Rescued::
	.string "The researchers are safe!$"

Route119_WeatherInstitute_2F_Text_Hostage::
	.string "AQUA wants the deep-sea data.\n"
	.string "Please help us!$"

Route119_WeatherInstitute_2F_Text_OfferCastform::
	.string "You saved our research team!\n"
	.string "Please take this CASTFORM.\p"
	.string "It changes with the weather.\n"
	.string "Will you travel with it?$"

Route119_WeatherInstitute_2F_Text_ResearchReport::
	.string "AQUA copied our ocean readings.\n"
	.string "STEVEN is tracing the same signal.\p"
	.string "He is at the SPACE CENTER in\n"
	.string "MOSSDEEP. Please speak with him.$"

Route119_WeatherInstitute_2F_Text_FourIslandColleague::
	.string "Our colleague on FOUR ISLAND\n"
	.string "told us about your travels.\p"
	.string "Your help has reached all the\n"
	.string "way from KANTO to HOENN.$"

Route119_WeatherInstitute_2F_Text_AfterSpace::
	.string "STEVEN confirmed the deep-sea\n"
	.string "signal using the satellite data.\p"
	.string "Please stop the teams before\n"
	.string "they disturb its source.$"
