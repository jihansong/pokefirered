

@ BEGIN PATCH (tools/hoenn_import/patches)
@ Shared ORBIT mission dialogue. Existing engine music is reused.

Space_Text_Offer::
	.string "TEAM ORBIT has seized our\n"
	.string "orbital research station.\p"
	.string "A comet left a sleeping star.\n"
	.string "ORBIT wants its hidden power.\p"
	.string "Will you board CAPTAIN REED'S\n"
	.string "ship and bring our people home?$"

Space_Text_Enrolled::
	.string "Your rescue berth is reserved.\n"
	.string "Take the north hatch to the pad.\p"
	.string "Get the briefing in NAVIGATION.\n"
	.string "The B-deck arena holds ORBIT.\p"
	.string "The lobby can bring you home\n"
	.string "if your team needs supplies.$"

Space_Text_Repeat::
	.string "The crew is safe and the station\n"
	.string "is sending research data again.\p"
	.string "The ship remains open to you.\n"
	.string "Any uncaught visitor still waits.$"

Space_Text_NotReady::
	.string "The SPACE CENTER is still under\n"
	.string "threat. Help STEVEN first.\p"
	.string "This new flight is a separate\n"
	.string "rescue operation after the raid.$"

Space_Text_Decline::
	.string "We will hold our position.\n"
	.string "Come back when you are ready.$"

Space_Text_Safety::
	.string "Every cabin is pressurized.\n"
	.string "You can return at any time.\p"
	.string "Our medic restores HP and PP\n"
	.string "between the two hostile teams.$"

Space_Text_Crew::
	.string "ORBIT copied valid staff badges.\n"
	.string "Their orders mention JIRACHI.\p"
	.string "Our people refused to obey.\n"
	.string "They were locked in the cargo hold.$"

Space_Text_Report::
	.string "All crew accounted for!\n"
	.string "The distress channel is clear.\p"
	.string "You protected a living creature\n"
	.string "and returned with the evidence.\p"
	.string "The rescue is complete, whether\n"
	.string "or not JIRACHI joined your team.$"

Space_Text_Hatch::
	.string "A new distress call reached us\n"
	.string "after the fuel theft was stopped.\p"
	.string "TEAM ORBIT has taken the crew\n"
	.string "of our orbital station hostage.\p"
	.string "Visit the west terminal counter.\n"
	.string "A rescue ship is waiting there.$"

Space_Text_ControlProgress::
	.string "The rescue ship is still ready.\n"
	.string "Your progress will be kept.\p"
	.string "Clear the arena and engine lock,\n"
	.string "then help the cargo researcher.$"

Space_Text_ReportAfter::
	.string "The rescued crew sent their\n"
	.string "thanks. The ship remains open.\p"
	.string "JIRACHI is free to choose.\n"
	.string "We will not force it awake.$"

Space_Text_Reward::
	.string "The three STAR PIECES are your\n"
	.string "field research grant. Thank you!$"

Space_Text_RewardFull::
	.string "Your field research grant is\n"
	.string "three STAR PIECES.\p"
	.string "Make room in the ITEMS pocket,\n"
	.string "then speak to me again.$"

Space_Text_Bridge::
	.string "CAPTAIN REED: Follow the bridge\n"
	.string "to the research ship's airlock.\p"
	.string "MIRA has seats for the passengers\n"
	.string "and medical space for your team.$"

Space_Text_PadReturned::
	.string "CAPTAIN REED: Everyone is home.\n"
	.string "Report inside the SPACE CENTER.\p"
	.string "The ship can return to the station\n"
	.string "if you left something unfinished.$"

Space_Text_PadSafety::
	.string "The passenger ship and launch\n"
	.string "vehicle are separate machines.\p"
	.string "The boosters and tank fall away.\n"
	.string "Only our winged ship goes on.$"

Space_Text_Board::
	.string "Board the rescue spacecraft?\n"
	.string "Your current progress is kept.$"

Space_Text_NotEnrolled::
	.string "A new rescue order is required.\n"
	.string "Speak at the terminal counter.\p"
	.string "An old survey reservation alone\n"
	.string "is not this mission'S clearance.$"

Space_Text_Return::
	.string "Return to the launch complex?\n"
	.string "The rescue can be resumed later.$"

Space_Text_SecureSeats::
	.string "CAPTAIN REED: Seats secured!\n"
	.string "We're heading for home.$"

Space_Text_CaptainAlert::
	.string "BOARDING OFFICER: REED is in\n"
	.string "his office beside navigation.\p"
	.string "Use the arena, then engineering.\n"
	.string "This berth can take you home.$"

Space_Text_CaptainRescued::
	.string "BOARDING OFFICER: The crew is\n"
	.string "safe and the station is secure.\p"
	.string "You decide when we return.\n"
	.string "JIRACHI can wait for a later visit.$"

Space_Text_OldVisitor::
	.string "A new rescue call is pending.\n"
	.string "Return to the terminal counter.\p"
	.string "Your earlier survey stays complete.\n"
	.string "This is a separate operation.$"

Space_Text_FlightCheck::
	.string "IVO: You found our ORBIT insignia?\n"
	.string "Then the disguise is useless.\p"
	.string "JIRACHI belongs in our collection.\n"
	.string "Will you stand in our way?$"

Space_Text_FlightDefeat::
	.string "Our orders said the passengers\n"
	.string "would be easy to silence!$"

Space_Text_FlightPassed::
	.string "The arena intruder is defeated.\n"
	.string "Security has taken IVO away.\p"
	.string "Rest at the clinic, then find\n"
	.string "ORBIT in engineering on C-deck.$"

Space_Text_Heal::
	.string "MEDIC: Let your team rest?\n"
	.string "I can restore HP, PP and status.$"

Space_Text_Healed::
	.string "Your team is ready.\n"
	.string "We will keep the cabin safe.$"

Space_Text_HealDecline::
	.string "I will keep the medical berth\n"
	.string "ready whenever you need it.$"

Space_Text_Pilot::
	.string "GUIDE: Navigation and the cockpit\n"
	.string "are on the upper deck.\p"
	.string "Guest rooms are down the hall.\n"
	.string "The return berth is to the south.$"

Space_Text_AttendantAlert::
	.string "MIRA: Visit NAVIGATION on A-deck.\n"
	.string "ORBIT is using the B-deck arena.\p"
	.string "Our clinic, shops and rooms\n"
	.string "stay open throughout the rescue.$"

Space_Text_AttendantSafe::
	.string "MIRA: The passengers are calm.\n"
	.string "The medic is across the aisle.\p"
	.string "The captain will return whenever\n"
	.string "you ask. Nobody is trapped here.$"

Space_Text_PassengerA::
	.string "I came to study the stars.\n"
	.string "Then ORBIT took our crew's badges!\p"
	.string "Please do not let them turn a\n"
	.string "living creature into equipment.$"

Space_Text_PassengerB::
	.string "The seat belt stays fastened\n"
	.string "during launch and descent.\p"
	.string "Walking around a cabin in orbit\n"
	.string "feels very different from a jet!$"

Space_Text_NeedFlightCheck::
	.string "LIORA: IVO holds the arena.\n"
	.string "You will not reach our apparatus.$"

Space_Text_SystemsCheck::
	.string "LIORA: TEAM ORBIT will awaken\n"
	.string "JIRACHI with the station's signal.\p"
	.string "The crew would not cooperate.\n"
	.string "Can you break our last defense?$"

Space_Text_SystemsDefeat::
	.string "The lock is broken!\n"
	.string "Our capture signal is fading!$"

Space_Text_SystemsPassed::
	.string "The ORBIT uplink is disabled.\n"
	.string "Security takes LIORA away.\p"
	.string "The cargo crew can now escape.\n"
	.string "Find their researcher in the hold.$"

Space_Text_EngineeringCrew::
	.string "They trapped our colleagues\n"
	.string "inside the cargo hold.\p"
	.string "ORBIT connected its capture signal\n"
	.string "to the research array.$"

Space_Text_EngineerSafe::
	.string "The emergency lock is released.\n"
	.string "The cargo crew needs your help.\p"
	.string "The researcher can transmit\n"
	.string "the records from the cargo hold.$"

Space_Text_ConsoleReady::
	.string "POWER: STABLE\n"
	.string "ORBIT SIGNAL: DISCONNECTED$"

Space_Text_ConsoleLocked::
	.string "The hostile uplink is active.\n"
	.string "Defeat the engineering intruder.$"

Space_Text_ObservatoryCrew::
	.string "Our colleagues are in cargo.\n"
	.string "Engineering controls their lock.\p"
	.string "Disable ORBIT, then help them.\n"
	.string "We will protect the fallen star.$"

Space_Text_ObserverRescued::
	.string "Everyone is free!\n"
	.string "A sleeping star has begun to glow.\p"
	.string "The starlight seems to hear\n"
	.string "your team. Approach when ready.$"

Space_Text_RecordsOffer::
	.string "ORBIT'S signal is disconnected.\n"
	.string "Release the crew and send evidence?$"

Space_Text_RecordsRecovered::
	.string "The crew berths unlock!\n"
	.string "The distress call reaches ground.\p"
	.string "A light stirs in the fallen star.\n"
	.string "JIRACHI is waking within it.\p"
	.string "You may approach it, or return\n"
	.string "with the captain and report now.$"

Space_Text_RecordsKnownJirachi::
	.string "The crew berths unlock!\n"
	.string "The evidence reaches ground.\p"
	.string "The bioscan matches a JIRACHI\n"
	.string "you have already recorded.\p"
	.string "No second capture is needed.\n"
	.string "Return with the captain to report.$"

Space_Text_RecordsAlready::
	.string "CREW: SAFE\n"
	.string "RESEARCH CHANNEL: RESTORED\p"
	.string "The captain can return at any time.\n"
	.string "Unfinished research stays available.$"

Space_Text_JirachiOffer::
	.string "The fallen star glows softly.\n"
	.string "JIRACHI answers your team's wish.\p"
	.string "Let the Lv.70 JIRACHI awaken?$"

Space_Text_JirachiRetry::
	.string "The star's light settles again.\n"
	.string "JIRACHI will await your return.\p"
	.string "Rest or make another visit.\n"
	.string "This encounter is not lost.$"

Space_Text_JirachiCaught::
	.string "JIRACHI chose to join your team.\n"
	.string "The fallen star's light fades.\p"
	.string "The crew can now study the stars\n"
	.string "without holding anything captive.$"

Space_Text_JirachiKnown::
	.string "The bioscan matches a JIRACHI\n"
	.string "already in your research records.\p"
	.string "The rescue remains complete.\n"
	.string "There is no second specimen here.$"

Space_Text_JirachiNoRoom::
	.string "Your party and every BOX are full.\n"
	.string "Make room before approaching.\p"
	.string "The captain can take you home.\n"
	.string "JIRACHI will wait for your return.$"
@ END PATCH
