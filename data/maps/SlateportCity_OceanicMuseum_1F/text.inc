

@ BEGIN PATCH (tools/hoenn_import/patches)
SlateportCity_OceanicMuseum_1F_Text_H0::
    .string "Welcome to the OCEANIC MUSEUM.\p"
    .string "The CAPTAIN's own survey is\n"
    .string "upstairs. Everything down here is\l"
    .string "what the sea is made of.$"

SlateportCity_OceanicMuseum_1F_Text_H1::
    .string "Take your time. Nobody has ever\n"
    .string "been hurried through here.\p"
    .string "Not even a champion off the KANTO\n"
    .string "plane.$"

SlateportCity_OceanicMuseum_1F_Text_H2::
    .string "Blue fluid turns slowly inside a\n"
    .string "glass drum.\p"
    .string "“WHIRLPOOL, made with nothing but\n"
    .string "moving air. The sea does the same\l"
    .string "with wind it is given.”$"

SlateportCity_OceanicMuseum_1F_Text_H3::
    .string "A red float rides up and down in a\n"
    .string "tall glass column.\p"
    .string "“WATERFALL. What climbs is not the\n"
    .string "water but the air caught in it.”$"

SlateportCity_OceanicMuseum_1F_Text_H4::
    .string "A core of seabed mud, sealed in\n"
    .string "glass.\p"
    .string "“Every band is a hundred years of\n"
    .string "things settling. Read down and you\l"
    .string "read backwards in time.”$"

SlateportCity_OceanicMuseum_1F_Text_H5::
    .string "A tray of beach sand.\p"
    .string "“It began as mountain stone. The\n"
    .string "rivers carried it, broke it, and\l"
    .string "the sea finished the job.”$"

SlateportCity_OceanicMuseum_1F_Text_H6::
    .string "A second core, taken further out.\p"
    .string "“The deeper the water, the finer\n"
    .string "the layers. Out past the shelf they\l"
    .string "are thin as paper.”$"

SlateportCity_OceanicMuseum_1F_Text_H7::
    .string "A tray of sand from a different\n"
    .string "beach.\p"
    .string "“Same rock, different river. No two\n"
    .string "coasts in HOENN feel alike\l"
    .string "underfoot.”$"

SlateportCity_OceanicMuseum_1F_Text_H8::
    .string "“WHY THE SEA LOOKS BLUE\p"
    .string "“Daylight carries every color at\n"
    .string "once. Water takes most of them\l"
    .string "within a few strides of depth.\p"
    .string "“Blue is the one that keeps going,\n"
    .string "so blue is what comes back up.”$"

SlateportCity_OceanicMuseum_1F_Text_H9::
    .string "“WHY THE SEA IS SALT\p"
    .string "“Rain falls on stone and takes a\n"
    .string "little of it away. The rivers carry\l"
    .string "that down to the sea.\p"
    .string "“The sea keeps it. It has been\n"
    .string "keeping it for a very long time.”$"

SlateportCity_OceanicMuseum_1F_Text_H10::
    .string "“SEA AND LAND\p"
    .string "“Seven parts water to three parts\n"
    .string "ground.\p"
    .string "“Every town you have ever walked\n"
    .string "through fits in the smaller share.”$"

SlateportCity_OceanicMuseum_1F_Text_H11::
    .string "A slab of stone with ridges across\n"
    .string "it, like a beach at low tide.\p"
    .string "“The tide combed this mud, and then\n"
    .string "the mud turned to rock with the\l"
    .string "combing still in it.”$"

SlateportCity_OceanicMuseum_1F_Text_H12::
    .string "Another ridged slab, this one\n"
    .string "cracked across the middle.\p"
    .string "“Found in GRANITE CAVE. The sea\n"
    .string "was up that high once.”$"

SlateportCity_OceanicMuseum_1F_Text_H13::
    .string "A machine turns slowly under a\n"
    .string "glass dome.\p"
    .string "“DEPTH SOUNDER. It counts how long\n"
    .string "a sound takes to come back.”$"

SlateportCity_OceanicMuseum_1F_Text_H14::
    .string "A second sounder, its dial stopped\n"
    .string "at a number somebody circled.\p"
    .string "“No return. Reading discarded.”$"
@ END PATCH
