

@ BEGIN PATCH (tools/hoenn_import/patches)
Route104_PrettyPetalFlowerShop_Text_H0::
    .string "Welcome to the PRETTY PETAL!\p"
    .string "We grow flowers for all of HOENN.\n"
    .string "My sisters and I, and one very\l"
    .string "small helper.$"

Route104_PrettyPetalFlowerShop_Text_H1::
    .string "Flowers are stubborn. Cut them\n"
    .string "back and they grow again.\p"
    .string "Like they've decided to live,\n"
    .string "and that's that.$"

Route104_PrettyPetalFlowerShop_Text_H2::
    .string "I'm growing things too, like my\n"
    .string "big sisters!\p"
    .string "This one came up today. Here you\n"
    .string "go! It's for you!$"

Route104_PrettyPetalFlowerShop_Text_BerryTomorrow::
    .string "Nothing else is ready today.\n"
    .string "Come back tomorrow!$"

Route104_PrettyPetalFlowerShop_Text_BerryBagFull::
    .string "Your BAG's full! I'll keep it in\n"
    .string "water for you.$"
@ END PATCH
